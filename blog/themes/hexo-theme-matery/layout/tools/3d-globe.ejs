    heading.appendChild(titleWrap);
    content.appendChild(heading);
    var tags = makeElement('div', 'g3d-info-tags');
    addInfoTag(tags, countryNameByCode(place.country));
    if (place.capital) addInfoTag(tags, '首都');
    addInfoTag(tags, place.type === 'city' ? '主要城市' : '精选地标');
    content.appendChild(tags);
    content.appendChild(makeElement('p', 'g3d-info-description', place.description));
    var grid = makeElement('div', 'g3d-info-grid');
    addInfoStat(grid, '纬度', formatCoordinateValue(place.lat, 'N', 'S'));
    addInfoStat(grid, '经度', formatCoordinateValue(place.lng, 'E', 'W'));
    addInfoStat(grid, '当地时间', '计算中…', 'g3dLocalTime');
    addInfoStat(grid, '所属国家', countryNameByCode(place.country));
    content.appendChild(grid);
    content.appendChild(makeElement('p', 'g3d-info-note', '城市与地标为精选探索数据，位置精度适合全球视角浏览。'));
    state.activeTimezone = place.timezone || null;
    updateClock();
  }

  function cameraDuration() {
    return reducedMotion ? 0 : 1100;
  }

  function pauseAutoRotate(resumeLater) {
    if (!state.controls) return;
    state.controls.autoRotate = false;
    window.clearTimeout(state.interactionTimer);
    if (resumeLater && state.autoRotateWanted && !document.hidden) {
      state.interactionTimer = window.setTimeout(function() {
        if (state.controls && state.autoRotateWanted && !state.destroyed && !document.hidden) {
          state.controls.autoRotate = true;
        }
      }, 7000);
    }
  }

  function syncAutoRotateButton() {
    var button = q('#g3dAutoRotate');
    button.setAttribute('aria-pressed', state.autoRotateWanted ? 'true' : 'false');
    button.setAttribute('aria-label', state.autoRotateWanted ? '暂停自动旋转' : '开启自动旋转');
    button.title = state.autoRotateWanted ? '暂停自动旋转' : '开启自动旋转';
    if (state.controls) state.controls.autoRotate = state.autoRotateWanted && !document.hidden;
  }

  function selectCountry(feature, point) {
    if (!feature || !feature.__g3d || !state.world) return;
    pauseAutoRotate(true);
    state.selectedCountry = feature;
    state.focusedPlace = null;
    if (window.matchMedia && window.matchMedia('(max-width: 800px)').matches) setLayerPanel(false);
    renderCountryInfo(feature);
    setInfoPanel(true);
    refreshPolygonStyles();
    updateDynamicLayers(true);
    var target = point && isFinite(point.lat) ? point : feature.__g3d.point;
    var span = feature.__g3d.point.span || 12;
    var altitude = clamp(.45 + span / 28, .55, 1.65);
    state.world.pointOfView({ lat: target.lat, lng: target.lng, altitude: altitude }, cameraDuration());
    setHint('已选择 ' + feature.__g3d.zh);
    announce('已选择' + feature.__g3d.zh + '，信息面板已打开。');
  }

  function selectPlace(place) {
    if (!place || !state.world) return;
    pauseAutoRotate(true);
    if (place.type === 'city') state.layers.cities = true;
    if (place.type === 'landmark') state.layers.landmarks = true;
    syncLayerButtons();
    state.focusedPlace = place;
    state.selectedCountry = state.countryByCode[place.country] || null;
    if (window.matchMedia && window.matchMedia('(max-width: 800px)').matches) setLayerPanel(false);
    renderPlaceInfo(place);
    setInfoPanel(true);
    refreshPolygonStyles();
    updateDynamicLayers(true);
    state.world.pointOfView({ lat: place.lat, lng: place.lng, altitude: place.type === 'city' ? .48 : .34 }, cameraDuration());
    setHint('已定位到 ' + place.zh);
    announce('已定位到' + place.zh + '，信息面板已打开。');
  }

  function setMarker(coords, label, kind) {
    state.marker = {
      id: 'active-marker',
      type: 'marker',
      lat: Number(coords.lat),
      lng: Number(coords.lng),
      label: label || '坐标标记',
      kind: kind || 'pin'
    };
    updateMarkerLayers();
  }

  function clearMarker() {
    state.marker = null;
    updateMarkerLayers();
    showToast('坐标标记已清除');
  }

  function resetView() {
    if (!state.world) return;
    pauseAutoRotate(true);
    closeInfo(true);
    state.marker = null;
    updateMarkerLayers();
    closeSearchResults();
    state.world.pointOfView(DEFAULT_VIEW, cameraDuration());
    setHint('已恢复默认视角');
    showToast('已恢复亚洲与中国附近的默认视角');
  }

  function switchLayer(layer) {
    if (!Object.prototype.hasOwnProperty.call(state.layers, layer)) return;
    if ((layer === 'borders' || layer === 'countryLabels') && state.countryStatus === 'error') {
      showToast('国家边界数据尚未加载，请先重新加载数据');
      return;
    }
    state.layers[layer] = !state.layers[layer];
    if (!state.world) {
      syncLayerButtons();
      return;
    }
    if (layer === 'borders') {
      state.world.polygonsData(state.layers.borders ? state.countries : []);
      refreshPolygonStyles();
    } else if (layer === 'countryLabels' || layer === 'cities' || layer === 'landmarks') {
      updateDynamicLayers(true);
    } else if (layer === 'graticules') {
      state.world.showGraticules(state.layers.graticules);
    } else if (layer === 'atmosphere') {
      state.world.showAtmosphere(state.layers.atmosphere);
    } else if (layer === 'night') {
      root.classList.toggle('is-night', state.layers.night);
      if (state.layers.night) {
        if (state.textureUrls.night) {
          applyResolvedTexture('night', state.textureUrls.night);
          showToast('已切换为静态夜景纹理');
        } else {
          showToast('正在加载夜景纹理…');
          loadTexture('night');
        }
      } else {
        if (state.textureUrls.day) {
          applyResolvedTexture('day', state.textureUrls.day);
        } else {
          state.world.globeImageUrl(null);
          setGlobeMaterialColor('#174b56');
          loadTexture('day');
        }
        showToast('已切换为日间地球');
      }
    } else if (layer === 'stars') {
      root.classList.toggle('is-stars', state.layers.stars);
    }
    syncLayerButtons();
  }

  function syncLayerButtons() {
    qa('[data-layer]').forEach(function(button) {
      var layer = button.getAttribute('data-layer');
      button.setAttribute('aria-checked', state.layers[layer] ? 'true' : 'false');
      button.disabled = !state.experienceReady ||
        ((layer === 'borders' || layer === 'countryLabels') && state.countryStatus === 'error') ||
        (layer === 'night' && state.textureStatus.night === 'error');
    });
  }

  function updateDataStatus(status, message) {
    state.countryStatus = status;
    var box = q('#g3dDataStatus');
    var icon = box.querySelector('i');
    box.classList.toggle('is-error', status === 'error');
    q('#g3dDataStatusText').textContent = message;
    icon.className = status === 'loading' ? 'fas fa-circle-notch fa-spin' : (status === 'error' ? 'fas fa-exclamation-circle' : 'fas fa-check-circle');
    syncLayerButtons();
  }

  function buildSearchIndex() {
    var countries = state.countries.map(function(feature) {
      return {
        id: 'country-' + feature.__g3d.code3,
        type: 'country',
        zh: feature.__g3d.zh,
        en: feature.__g3d.en,
        search: feature.__g3d.search,
        feature: feature
      };
    });
    var places = PLACES.map(function(place) {
      return {
        id: 'place-' + place.id,
        type: place.type,
        zh: place.zh,
        en: place.en,
        search: normalizeText([place.zh, place.en, countryNameByCode(place.country), place.country].join(' ')),
        place: place
      };
    });
    state.searchItems = countries.concat(places);
  }

  function searchScore(item, query) {
    var zh = normalizeText(item.zh);
    var en = normalizeText(item.en);
    if (zh === query || en === query) return 0;
    if (zh.indexOf(query) === 0) return 1;
    if (en.indexOf(query) === 0) return 2;
    var index = item.search.indexOf(query);
    return index === -1 ? 9999 : 10 + index;
  }

  function renderSearchResults() {
    var input = q('#g3dSearch');
    var results = q('#g3dSearchResults');
    var query = normalizeText(input.value);
    q('#g3dSearchClear').classList.toggle('is-visible', !!input.value);
    clearNode(results);
    state.activeSearchIndex = -1;
    state.visibleSearchItems = [];
    if (!query) {
      closeSearchResults();
      return;
    }
    state.visibleSearchItems = state.searchItems
      .map(function(item) { return { item: item, score: searchScore(item, query) }; })
      .filter(function(result) { return result.score < 9999; })
      .sort(function(a, b) {
        var typeOrder = { country: 0, city: 1, landmark: 2 };
        return a.score - b.score ||
          typeOrder[a.item.type] - typeOrder[b.item.type] ||
          a.item.zh.localeCompare(b.item.zh, 'zh-CN');
      })
      .slice(0, 9)
      .map(function(result) { return result.item; });

    if (!state.visibleSearchItems.length) {
      var message = state.countryStatus === 'loading'
        ? '国家数据仍在加载，暂未找到匹配的城市或地标'
        : (state.countryStatus === 'error'
          ? '国家索引暂不可用，精选城市与地标中也没有匹配结果'
          : '没有找到匹配的国家、城市或地标');
      results.appendChild(makeElement('p', 'g3d-search-empty', message));
    } else {
      state.visibleSearchItems.forEach(function(item, index) {
        var button = makeElement('button', 'g3d-search-option');
        button.type = 'button';
        button.id = 'g3dSearchOption' + index;
        button.setAttribute('role', 'option');
        button.setAttribute('aria-selected', 'false');
        button.setAttribute('data-search-index', index);
        var icon = makeElement('span', 'g3d-search-option-icon');
        var iconEl = document.createElement('i');
        iconEl.className = item.type === 'country' ? 'fas fa-flag' : (item.type === 'city' ? 'fas fa-city' : 'fas fa-landmark');
        icon.appendChild(iconEl);
        button.appendChild(icon);
        var copy = makeElement('span', 'g3d-search-option-copy');
        copy.appendChild(makeElement('span', 'g3d-search-option-name', item.zh));
        copy.appendChild(makeElement('span', 'g3d-search-option-sub', item.en + (item.type === 'country' ? '' : ' · ' + countryNameByCode(item.place.country))));
        button.appendChild(copy);
        button.appendChild(makeElement('span', 'g3d-search-option-type', item.type === 'country' ? '国家' : (item.type === 'city' ? '城市' : '地标')));
        results.appendChild(button);
      });
    }
    results.classList.add('is-open');
    input.setAttribute('aria-expanded', 'true');
  }

  function closeSearchResults() {
    q('#g3dSearchResults').classList.remove('is-open');
    q('#g3dSearch').setAttribute('aria-expanded', 'false');
    q('#g3dSearch').removeAttribute('aria-activedescendant');
    state.activeSearchIndex = -1;
  }

  function setActiveSearchIndex(index) {
    if (!state.visibleSearchItems.length) return;
    state.activeSearchIndex = (index + state.visibleSearchItems.length) % state.visibleSearchItems.length;
    qa('.g3d-search-option').forEach(function(button, buttonIndex) {
      var active = buttonIndex === state.activeSearchIndex;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', active ? 'true' : 'false');
      if (active) button.scrollIntoView({ block: 'nearest' });
    });
    q('#g3dSearch').setAttribute('aria-activedescendant', 'g3dSearchOption' + state.activeSearchIndex);
  }

  function activateSearchItem(item) {
    if (!item) return;
    var search = q('#g3dSearch');
    var keepSearchFocus = document.activeElement === search;
    search.value = item.zh;
    q('#g3dSearchClear').classList.add('is-visible');
    closeSearchResults();
    if (item.type === 'country') selectCountry(item.feature, item.feature.__g3d.point);
    else selectPlace(item.place);
    if (!keepSearchFocus) focusSafely(stage);
  }

  function fetchJson(url, timeout) {
    var controller = window.AbortController ? new AbortController() : null;
    state.fetchController = controller;
    var timer = window.setTimeout(function() {
      if (controller) controller.abort();
    }, timeout || 12000);
    return fetch(url, {
      signal: controller ? controller.signal : undefined,
      cache: 'force-cache'
    }).then(function(response) {
      if (!response.ok) throw new Error('HTTP ' + response.status);
      return response.json();
    }).finally(function() {
      window.clearTimeout(timer);
      if (state.fetchController === controller) state.fetchController = null;
    });
  }

  function fetchCountriesFrom(index, requestId) {
    return fetchJson(COUNTRY_URLS[index], 14000).catch(function(error) {
      if (requestId !== state.countryRequestId) throw error;
      if (index + 1 < COUNTRY_URLS.length && !state.destroyed) return fetchCountriesFrom(index + 1, requestId);
      throw error;
    });
  }

  function loadCountries() {
    if (state.destroyed) return;
    var requestId = ++state.countryRequestId;
    if (state.fetchController) state.fetchController.abort();
    updateDataStatus('loading', '正在加载国家边界数据…');
    setHint('正在加载国家边界与名称…');
    fetchCountriesFrom(0, requestId).then(function(data) {
      if (state.destroyed || requestId !== state.countryRequestId) return;
      if (!data || !Array.isArray(data.features)) throw new Error('GeoJSON 格式不正确');
      state.countries = data.features.filter(function(feature) {
        return feature && feature.geometry && (feature.geometry.type === 'Polygon' || feature.geometry.type === 'MultiPolygon');
      }).map(prepareFeature);
      state.countryByCode = {};
      state.countries.forEach(function(feature) {
        if (feature.__g3d.code3) state.countryByCode[feature.__g3d.code3] = feature;
      });
      buildSearchIndex();
      if (state.world) {
        state.world.polygonsData(state.layers.borders ? state.countries : []);
        refreshPolygonStyles();
        updateDynamicLayers(true);
      }
      updateDataStatus('ready', '已加载 ' + state.countries.length + ' 个国家与地区边界');
      if (q('#g3dSearch').value && q('#g3dSearchResults').classList.contains('is-open')) renderSearchResults();
      setHint('拖动地球开始探索');
      announce('国家边界数据加载完成，可以搜索或点击国家查看信息。');
    }).catch(function(error) {
      if (state.destroyed || requestId !== state.countryRequestId) return;
      state.countries = [];
      state.countryByCode = {};
      buildSearchIndex();
      updateDataStatus('error', '国家边界加载失败，基础地球仍可使用');
      if (q('#g3dSearch').value && q('#g3dSearchResults').classList.contains('is-open')) renderSearchResults();
      setHint('国家数据加载失败，可在图层面板重试');
      showToast('国家边界加载失败，已保留基础地球操作', 4200);
      if (window.console && console.error) console.error('[3D 地球仪] 国家数据加载失败：', error);
    });
  }

  function updateClock() {
    var now = new Date();
    q('#g3dUtcTime').textContent = now.toISOString().slice(11, 19) + ' UTC';
    var local = q('#g3dLocalTime');
    if (local && state.activeTimezone) {
      try {
        local.textContent = new Intl.DateTimeFormat('zh-CN', {
          timeZone: state.activeTimezone,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false
        }).format(now);
      } catch (error) {
        local.textContent = '—';
      }
    }
  }

  function updateZoomStatus(altitude) {
    var text = altitude > 1.8 ? '全球视角' : (altitude > 1.05 ? '区域视角' : (altitude > .55 ? '国家视角' : '城市标记视角'));
    q('#g3dZoomStatus').textContent = text + ' · ' + altitude.toFixed(2) + '×';
  }

  function resizeGlobe() {
    if (!state.world || state.destroyed) return;
    var width = Math.max(1, stage.clientWidth);
    var height = Math.max(1, stage.clientHeight);
    state.world.width(width).height(height);
    updateGlobeOffset();
    try {
      state.world.renderer().setPixelRatio(Math.min(window.devicePixelRatio || 1, lowPower ? 1.35 : 1.8));
    } catch (error) {}
  }

  function scheduleResize() {
    if (state.resizeFrame) return;
    state.resizeFrame = window.requestAnimationFrame(function() {
      state.resizeFrame = null;
      resizeGlobe();
    });
  }

  function requestFullscreen() {
    var active = document.fullscreenElement || document.webkitFullscreenElement;
    if (!active) {
      var request = root.requestFullscreen || root.webkitRequestFullscreen;
      if (!request) {
        showToast('当前浏览器不支持全屏模式');
        return;
      }
      var result = request.call(root);
      if (result && result.catch) result.catch(function() { showToast('无法进入全屏模式'); });
    } else {
      var exit = document.exitFullscreen || document.webkitExitFullscreen;
      if (exit) exit.call(document);
    }
  }

  function onFullscreenChange() {
    var active = document.fullscreenElement === root || document.webkitFullscreenElement === root;
    var button = q('#g3dFullscreen');
    button.setAttribute('aria-pressed', active ? 'true' : 'false');
    button.setAttribute('aria-label', active ? '退出全屏' : '进入全屏');
    button.title = active ? '退出全屏' : '全屏';
    button.querySelector('i').className = active ? 'fas fa-compress' : 'fas fa-expand';
    scheduleResize();
    announce(active ? '已进入全屏模式。' : '已退出全屏模式。');
  }

  function locateUser() {
    if (!navigator.geolocation) {
      showToast('当前浏览器不支持定位功能');
      return;
    }
    var button = q('#g3dLocate');
    button.disabled = true;
    button.querySelector('i').className = 'fas fa-circle-notch fa-spin';
    showToast('正在获取你的位置…', 2200);
    navigator.geolocation.getCurrentPosition(function(position) {
      if (state.destroyed) return;
      button.disabled = !state.experienceReady;
      button.querySelector('i').className = 'fas fa-location-arrow';
      var coords = { lat: position.coords.latitude, lng: position.coords.longitude };
      setMarker(coords, '我的位置', 'location');
      pauseAutoRotate(true);
      if (state.world) state.world.pointOfView({ lat: coords.lat, lng: coords.lng, altitude: .55 }, cameraDuration());
      closeInfo(true);
      setHint('已定位到你的大致位置');
      announce('已定位到你的大致位置。');
      showToast('定位成功，位置仅用于当前页面显示');
    }, function(error) {
      if (state.destroyed) return;
      button.disabled = !state.experienceReady;
      button.querySelector('i').className = 'fas fa-location-arrow';
      var message = error && error.code === 1 ? '你没有授权位置访问，其他功能不受影响' : '暂时无法获取位置，请稍后重试';
      showToast(message, 3600);
      announce(message);
    }, { enableHighAccuracy: false, timeout: 12000, maximumAge: 300000 });
  }

  function copyCoordinates() {
    if (!state.marker) return;
    var text = state.marker.lat.toFixed(6) + ', ' + state.marker.lng.toFixed(6);
    function done() { showToast('经纬度已复制'); }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(function() { fallbackCopy(text, done); });
    } else {
      fallbackCopy(text, done);
    }
  }

  function fallbackCopy(text, callback) {
    var input = document.createElement('textarea');
    input.value = text;
    input.style.position = 'fixed';
    input.style.left = '-9999px';
    document.body.appendChild(input);
    input.select();
    try {
      if (document.execCommand('copy')) callback();
      else showToast('复制失败，请手动记录坐标');
    } catch (error) {
      showToast('复制失败，请手动记录坐标');
    }
    document.body.removeChild(input);
  }

  function onRendererPointerMove(event) {
    if (!state.world || state.pointerFrame) return;
    state.pointerFrame = window.requestAnimationFrame(function() {
      state.pointerFrame = null;
      var rect = canvasHost.getBoundingClientRect();
      var coords = state.world.toGlobeCoords(event.clientX - rect.left, event.clientY - rect.top);
      q('#g3dPointerCoords').textContent = coords ? formatCoordinates(coords.lat, coords.lng) : '指针位于地球之外';
    });
  }

  function onStageKeydown(event) {
    if (event.target !== stage || !state.world || !state.experienceReady) return;
    var key = event.key;
    var isZoomIn = key === '+' || key === '=' || event.code === 'NumpadAdd';
    var isZoomOut = key === '-' || key === '_' || event.code === 'NumpadSubtract';
    if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].indexOf(key) === -1 && !isZoomIn && !isZoomOut) return;
    event.preventDefault();
    var current;
    try { current = state.world.pointOfView(); } catch (error) { current = null; }
    current = current || { lat: DEFAULT_VIEW.lat, lng: DEFAULT_VIEW.lng, altitude: state.currentAltitude };
    var step = event.shiftKey ? 15 : 6;
    var lat = Number(current.lat) || 0;
    var lng = Number(current.lng) || 0;
    var altitude = Number(current.altitude) || state.currentAltitude || DEFAULT_VIEW.altitude;
    if (key === 'ArrowLeft') lng -= step;
    if (key === 'ArrowRight') lng += step;
    if (key === 'ArrowUp') lat += step;
    if (key === 'ArrowDown') lat -= step;
    if (isZoomIn) altitude *= .8;
    if (isZoomOut) altitude *= 1.25;
    lat = clamp(lat, -85, 85);
    lng = ((lng + 180) % 360 + 360) % 360 - 180;
    altitude = clamp(altitude, .22, 4.5);
    pauseAutoRotate(true);
    state.world.pointOfView({ lat: lat, lng: lng, altitude: altitude }, reducedMotion ? 0 : 240);
    setHint(isZoomIn || isZoomOut ? '已使用键盘缩放地球' : '已使用方向键旋转地球');
  }

  function onVisibilityChange() {
    if (document.hidden) {
      state.pausedForVisibility = true;
      pauseAutoRotate(false);
      if (state.world) state.world.pauseAnimation();
    } else if (state.pausedForVisibility) {
      state.pausedForVisibility = false;
      if (state.world) {
        state.world.resumeAnimation();
        syncAutoRotateButton();
      }
    }
  }

  function bindUi() {
    listen(q('#g3dAutoRotate'), 'click', function() {
      state.autoRotateWanted = !state.autoRotateWanted;
      window.clearTimeout(state.interactionTimer);
      syncAutoRotateButton();
      showToast(state.autoRotateWanted ? '自动旋转已开启' : '自动旋转已暂停');
    });
    listen(q('#g3dResetView'), 'click', resetView);
    listen(q('#g3dLocate'), 'click', locateUser);
    listen(q('#g3dLayersToggle'), 'click', function() { setLayerPanel(!state.layerPanelOpen); });
    listen(q('#g3dLayerClose'), 'click', function() { setLayerPanel(false, true); });
    listen(q('#g3dInfoClose'), 'click', function() { closeInfo(true, true); });
    listen(q('#g3dFullscreen'), 'click', requestFullscreen);
    listen(q('#g3dGuideClose'), 'click', hideGuide);
    listen(q('#g3dCopyCoords'), 'click', copyCoordinates);
    listen(q('#g3dClearMarker'), 'click', clearMarker);
    listen(q('#g3dRetryData'), 'click', loadCountries);
    listen(q('#g3dReload'), 'click', function() { window.location.reload(); });
    qa('[data-layer]').forEach(function(button) {
      listen(button, 'click', function() { switchLayer(button.getAttribute('data-layer')); });
    });

    var search = q('#g3dSearch');
    listen(search, 'input', renderSearchResults);
    listen(search, 'focus', function() {
      if (search.value) renderSearchResults();
    });
    listen(search, 'keydown', function(event) {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActiveSearchIndex(state.activeSearchIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActiveSearchIndex(state.activeSearchIndex - 1);
      } else if (event.key === 'Enter' && state.activeSearchIndex >= 0) {
        event.preventDefault();
        activateSearchItem(state.visibleSearchItems[state.activeSearchIndex]);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        closeSearchResults();
      }
    });
    listen(q('#g3dSearchResults'), 'click', function(event) {
      var button = event.target.closest('[data-search-index]');
      if (!button) return;
      activateSearchItem(state.visibleSearchItems[Number(button.getAttribute('data-search-index'))]);
    });
    listen(q('#g3dSearchClear'), 'click', function() {
      search.value = '';
      q('#g3dSearchClear').classList.remove('is-visible');
      closeSearchResults();
      search.focus();
    });
    listen(document, 'pointerdown', function(event) {
      if (!q('.g3d-search-wrap').contains(event.target)) closeSearchResults();
    });
    listen(document, 'keydown', function(event) {
      if (event.key !== 'Escape' || event.defaultPrevented) return;
      if (q('#g3dSearchResults').classList.contains('is-open')) {
        closeSearchResults();
      } else if (state.infoPanelOpen) {
        closeInfo(true, true);
      } else if (state.layerPanelOpen) {
        setLayerPanel(false, true);
      }
    });
    listen(stage, 'keydown', onStageKeydown);
    listen(document, 'fullscreenchange', onFullscreenChange);
    listen(document, 'webkitfullscreenchange', onFullscreenChange);
    listen(document, 'visibilitychange', onVisibilityChange);
    listen(window, 'resize', scheduleResize);
    listen(window, 'orientationchange', scheduleResize);
    listen(window, 'pagehide', function(event) {
      if (event.persisted) {
        if (state.world) state.world.pauseAnimation();
      } else {
        destroy();
      }
    });
    listen(window, 'pageshow', function(event) {
      if (event.persisted && state.world) {
        if (document.hidden) {
          state.pausedForVisibility = true;
          state.world.pauseAnimation();
        } else {
          state.pausedForVisibility = false;
          state.world.resumeAnimation();
          syncAutoRotateButton();
          scheduleResize();
        }
      }
    });
  }

  function configureWorld() {
    setLoading('正在创建三维地球…');
    try {
      state.world = new Globe(canvasHost, {
        rendererConfig: { antialias: !lowPower, alpha: true, powerPreference: lowPower ? 'default' : 'high-performance' },
        waitForGlobeReady: false,
        animateIn: !reducedMotion
      })
        .backgroundColor('rgba(0,0,0,0)')
        .showAtmosphere(state.layers.atmosphere)
        .atmosphereColor('#6ce6ef')
        .atmosphereAltitude(.18)
        .showGraticules(state.layers.graticules)
        .polygonLabel(countryTooltip)
        .polygonCapCurvatureResolution(3)
        .polygonsTransitionDuration(reducedMotion ? 0 : 260)
        .onPolygonHover(function(feature) {
          state.hoveredCountry = feature || null;
          refreshPolygonStyles();
          if (feature && feature.__g3d) setHint(feature.__g3d.zh + ' · 点击查看信息');
          else if (!state.infoPanelOpen) setHint('拖动地球开始探索');
        })
        .onPolygonClick(function(feature, event, coords) {
          selectCountry(feature, coords || feature.__g3d.point);
        })
        .pointLat('lat')
        .pointLng('lng')
        .pointAltitude(function(item) { return item.type === 'marker' ? .07 : (item.type === 'landmark' ? .045 : .032); })
        .pointRadius(function(item) { return item.type === 'marker' ? .26 : (item === state.focusedPlace ? .2 : .12); })
        .pointColor(function(item) {
          if (item.type === 'marker') return item.kind === 'location' ? '#7ccd00' : '#ffca62';
          if (item === state.focusedPlace) return '#ffffff';
          return item.type === 'landmark' ? '#e37cff' : '#ffca62';
        })
        .pointLabel(function(item) { return item.type === 'marker' ? escapeHtml(item.label) : placeTooltip(item); })
        .pointsTransitionDuration(reducedMotion ? 0 : 320)
        .onPointClick(function(item) {
          if (item.type !== 'marker') selectPlace(item);
        })
        .ringLat('lat')
        .ringLng('lng')
        .ringAltitude(.012)
        .ringColor(function(item) { return function(t) { return 'rgba(255, 202, 98, ' + (1 - t) + ')'; }; })
        .ringMaxRadius(2.8)
        .ringPropagationSpeed(1.5)
        .ringRepeatPeriod(1000)
        .htmlLat('lat')
        .htmlLng('lng')
        .htmlAltitude('altitude')
        .htmlElement(createMapLabel)
        .htmlTransitionDuration(reducedMotion ? 0 : 260)
        .onGlobeClick(function(coords, event) {
          if (!coords) return;
          closeInfo(true);
          setMarker(coords, '坐标标记', 'pin');
          if (event && event.detail > 1) {
            pauseAutoRotate(true);
            state.world.pointOfView({ lat: coords.lat, lng: coords.lng, altitude: .48 }, cameraDuration());
            setHint('已放大到双击位置');
          } else {
            setHint('已标记 ' + formatCoordinates(coords.lat, coords.lng));
          }
        })
        .onZoom(function(pov) {
          state.currentAltitude = Number(pov.altitude) || DEFAULT_VIEW.altitude;
          updateZoomStatus(state.currentAltitude);
          updateDynamicLayers(false);
        });

      try {
        var material = state.world.globeMaterial();
        if (material && material.color && material.color.set) material.color.set(state.textureUrls.day ? '#ffffff' : '#174b56');
        if (material && material.shininess !== undefined) material.shininess = 12;
      } catch (error) {}
      if (state.textureUrls.day) applyResolvedTexture('day', state.textureUrls.day);
      if (!lowPower && state.textureUrls.bump) applyResolvedTexture('bump', state.textureUrls.bump);

      state.controls = state.world.controls();
      state.controls.enableDamping = true;
      state.controls.dampingFactor = .08;
      state.controls.enablePan = false;
      state.controls.zoomSpeed = .75;
      state.controls.rotateSpeed = .55;
      state.controls.autoRotateSpeed = .24;
      var radius = state.world.getGlobeRadius();
      state.controls.minDistance = radius * 1.18;
      state.controls.maxDistance = radius * 5.6;
      listen(state.controls, 'start', function() {
        pauseAutoRotate(false);
        hideGuide();
      });
      listen(state.controls, 'end', function() { pauseAutoRotate(true); });
      syncAutoRotateButton();

      state.world.pointOfView(DEFAULT_VIEW, 0);
      state.currentAltitude = DEFAULT_VIEW.altitude;
      updateZoomStatus(state.currentAltitude);
      resizeGlobe();
      state.world.polygonsData(state.layers.borders ? state.countries : []);
      refreshPolygonStyles();
      updateDynamicLayers(true);

      state.rendererCanvas = state.world.renderer().domElement;
      state.rendererCanvas.setAttribute('aria-label', '可拖动和缩放的三维地球');
      listen(state.rendererCanvas, 'pointermove', onRendererPointerMove);
      listen(state.rendererCanvas, 'pointerleave', function() {
        q('#g3dPointerCoords').textContent = '移动指针查看经纬度';
      });
      listen(state.rendererCanvas, 'webglcontextlost', function(event) {
        event.preventDefault();
        if (state.world) state.world.pauseAnimation();
        setExperienceReady(false);
        window.clearTimeout(state.contextLossTimer);
        state.contextLossTimer = window.setTimeout(function() {
          if (!state.destroyed && !state.experienceReady) {
            showFatal('三维显示未能自动恢复', 'WebGL 图形上下文长时间不可用，请刷新页面重新创建三维地球。');
          }
        }, 8000);
        showToast('图形上下文已丢失，正在等待浏览器恢复', 5000);
        setHint('WebGL 上下文暂时不可用');
      });
      listen(state.rendererCanvas, 'webglcontextrestored', function() {
        window.clearTimeout(state.contextLossTimer);
        state.contextLossTimer = null;
        q('#g3dFatal').hidden = true;
        setExperienceReady(true);
        if (document.hidden) {
          state.pausedForVisibility = true;
          return;
        }
        if (state.world) state.world.resumeAnimation();
        syncAutoRotateButton();
        scheduleResize();
        showToast('三维地球显示已恢复');
      });

      setExperienceReady(true);
      canvasHost.classList.add('is-ready');
      hideLoading();
      setHint(state.countryStatus === 'ready' ? '拖动地球开始探索' : '地球已就绪，正在加载国家边界…');
      announce('三维地球已加载。拖动旋转，滚轮或双指缩放。');
      if (document.hidden) {
        state.pausedForVisibility = true;
        state.world.pauseAnimation();
      }
      if (window.ResizeObserver) {
        state.resizeObserver = new ResizeObserver(scheduleResize);
        state.resizeObserver.observe(stage);
      }
    } catch (error) {
      if (window.console && console.error) console.error('[3D 地球仪] 初始化失败：', error);
      showFatal('3D 引擎初始化失败', '浏览器无法创建三维场景，请刷新页面或更换支持 WebGL2 的现代浏览器后重试。');
    }
  }

  function destroy() {
    if (state.destroyed) return;
    state.destroyed = true;
    window.clearTimeout(state.interactionTimer);
    window.clearTimeout(state.guideTimer);
    window.clearTimeout(state.toastTimer);
    window.clearTimeout(state.contextLossTimer);
    window.clearInterval(state.clockTimer);
    if (state.resizeFrame) window.cancelAnimationFrame(state.resizeFrame);
    if (state.pointerFrame) window.cancelAnimationFrame(state.pointerFrame);
    if (state.fetchController) state.fetchController.abort();
    if (state.resizeObserver) state.resizeObserver.disconnect();
    cleanup.splice(0).forEach(function(remove) {
      try { remove(); } catch (error) {}
    });
    if (state.world) {
      try { state.world.pauseAnimation(); } catch (error) {}
      try { state.world.renderer().dispose(); } catch (error) {}
    }
    window.__meowv3dGlobeInitialized = false;
  }

  function waitForEngine(attempt) {
    if (state.destroyed) return;
    if (typeof window.Globe === 'function') {
      configureWorld();
      return;
    }
    if (attempt >= 100) {
      showFatal('3D 资源加载失败', '无法从 CDN 加载 Globe.gl。请检查网络连接、内容拦截设置，或稍后刷新重试。');
      return;
    }
    window.setTimeout(function() { waitForEngine(attempt + 1); }, 100);
  }

  function init() {
    bindUi();
    buildSearchIndex();
    setExperienceReady(false);
    syncAutoRotateButton();
    setLayerPanel(state.layerPanelOpen);
    syncLayerButtons();
    updateClock();
    state.clockTimer = window.setInterval(updateClock, 1000);
    state.guideTimer = window.setTimeout(function() {
      hideGuide();
    }, 7200);
    if (!state.fullscreenSupported) {
      q('#g3dFullscreen').disabled = true;
      q('#g3dFullscreen').title = '当前浏览器不支持全屏';
    }
    if (!supportsWebGL2()) {
      showFatal('当前设备不支持三维地球', '当前浏览器或设备不支持三维地球展示，请升级浏览器后重试。');
      return;
    }
    loadTexture('day');
    if (!lowPower) loadTexture('bump');
    loadCountries();
    waitForEngine(0);
  }

  init();
})();
</script>
