<%- partial('_partial/bg-cover') %>

<style>
  .g3d-container {
    width: 94%;
    max-width: 1480px;
    margin-top: -50px;
    margin-bottom: 30px;
  }
  .g3d-container > .card {
    overflow: hidden;
    border-radius: 8px;
  }
  .g3d-container > .card > .card-content {
    padding: 12px;
  }
  .g3d-app {
    --g3d-accent: #7ccd00;
    --g3d-green: #5a9600;
    --g3d-cyan: #45d9d0;
    --g3d-panel: rgba(7, 22, 37, .82);
    --g3d-panel-strong: rgba(6, 18, 31, .94);
    --g3d-line: rgba(142, 220, 232, .2);
    --g3d-text: #eefcff;
    --g3d-muted: #91aebb;
    position: relative;
    overflow: hidden;
    border: 1px solid #dfe8e9;
    border-radius: 12px;
    color: var(--g3d-text);
    background: #030a13;
    box-shadow: 0 18px 45px rgba(3, 19, 29, .16);
  }
  .g3d-app *,
  .g3d-app *::before,
  .g3d-app *::after {
    box-sizing: border-box;
  }
  .g3d-sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
  .g3d-toolbar {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 64px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--g3d-line);
    background: linear-gradient(180deg, rgba(10, 29, 45, .98), rgba(7, 23, 37, .94));
  }
  .g3d-mode-chip {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid rgba(124, 205, 0, .3);
    border-radius: 20px;
    color: #c9ee9e;
    background: rgba(90, 150, 0, .12);
    font-size: .75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .g3d-mode-chip i {
    color: var(--g3d-accent);
  }
  .g3d-search-wrap {
    position: relative;
    flex: 1 1 430px;
    max-width: 620px;
    min-width: 190px;
  }
  .g3d-search-box {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    overflow: hidden;
    border: 1px solid rgba(145, 203, 215, .26);
    border-radius: 22px;
    background: rgba(255, 255, 255, .08);
    transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .g3d-search-box:focus-within {
    border-color: rgba(124, 205, 0, .74);
    background: rgba(255, 255, 255, .11);
    box-shadow: 0 0 0 3px rgba(124, 205, 0, .1);
  }
  .g3d-search-icon {
    flex: 0 0 38px;
    color: #83a7b4;
    text-align: center;
  }
  .g3d-search-input {
    width: 100% !important;
    height: 42px !important;
    margin: 0 !important;
    padding: 0 38px 0 0 !important;
    border: 0 !important;
    outline: 0 !important;
    color: #fff !important;
    background: transparent !important;
    box-shadow: none !important;
    font-size: .86rem !important;
  }
  .g3d-search-input::-webkit-search-cancel-button {
    display: none;
  }
  .g3d-search-input::placeholder {
    color: #78939e;
  }
  .g3d-search-clear {
    position: absolute;
    top: 5px;
    right: 7px;
    display: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #9bb2ba;
    background: transparent;
    cursor: pointer;
  }
  .g3d-search-clear.is-visible {
    display: inline-flex;
  }
  .g3d-search-results {
    position: absolute;
    z-index: 90;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    display: none;
    max-height: min(420px, 62vh);
    overflow-y: auto;
    padding: 7px;
    border: 1px solid rgba(133, 207, 219, .25);
    border-radius: 12px;
    background: rgba(5, 19, 32, .98);
    box-shadow: 0 18px 45px rgba(0, 0, 0, .38);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }
  .g3d-search-results.is-open {
    display: block;
  }
  .g3d-search-option {
    display: flex;
    width: 100%;
    min-height: 54px;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border: 0;
    border-radius: 8px;
    color: #e9f8fb;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .g3d-search-option:hover,
  .g3d-search-option.is-active,
  .g3d-search-option:focus {
    color: #fff !important;
    background: rgba(74, 137, 152, .24) !important;
    outline: none;
  }
  .g3d-search-option-icon {
    display: grid;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid rgba(124, 205, 0, .24);
    border-radius: 10px;
    color: #b8eb7a;
    background: rgba(124, 205, 0, .08);
    font-size: .95rem;
  }
  .g3d-search-option-copy {
    min-width: 0;
    flex: 1;
  }
  .g3d-search-option-name,
  .g3d-search-option-sub {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .g3d-search-option-name {
    font-size: .84rem;
    font-weight: 600;
  }
  .g3d-search-option-sub {
    margin-top: 2px;
    color: #829ca7;
    font-size: .68rem;
  }
  .g3d-search-option-type {
    flex: 0 0 auto;
    padding: 3px 7px;
    border: 1px solid rgba(134, 207, 219, .2);
    border-radius: 10px;
    color: #8fb5bf;
    font-size: .62rem;
  }
  .g3d-search-empty {
    margin: 0;
    padding: 22px 12px;
    color: #87a2ac;
    font-size: .78rem;
    text-align: center;
  }
  .g3d-toolbar-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .g3d-tool-button,
  .g3d-panel-close,
  .g3d-guide-close,
  .g3d-mini-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(145, 203, 215, .2);
    color: #bdd1d7;
    background: rgba(255, 255, 255, .06);
    cursor: pointer;
    transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .g3d-tool-button {
    position: relative;
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 11px;
    font-size: .92rem;
  }
  .g3d-tool-button:hover,
  .g3d-panel-close:hover,
  .g3d-guide-close:hover,
  .g3d-mini-button:hover {
    border-color: rgba(124, 205, 0, .52);
    color: #d9ffad;
    background: rgba(124, 205, 0, .13);
  }
  .g3d-tool-button:focus,
  .g3d-panel-close:focus,
  .g3d-guide-close:focus,
  .g3d-mini-button:focus,
  .g3d-search-clear:focus {
    color: #e9ffcb !important;
    background: rgba(124, 205, 0, .16) !important;
    outline: 2px solid rgba(124, 205, 0, .74) !important;
    outline-offset: 2px;
  }
  .g3d-tool-button[aria-pressed="true"],
  .g3d-tool-button[aria-expanded="true"] {
    border-color: rgba(124, 205, 0, .56);
    color: #d8ffac;
    background: rgba(90, 150, 0, .23);
    box-shadow: inset 0 0 0 1px rgba(124, 205, 0, .08);
  }
  .g3d-tool-button:disabled {
    opacity: .38;
    cursor: not-allowed;
  }
  .g3d-tool-button .g3d-button-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .g3d-stage {
    position: relative;
    height: clamp(620px, 70vh, 820px);
    min-height: 620px;
    overflow: hidden;
    outline: none;
    background:
      radial-gradient(circle at 50% 45%, rgba(13, 67, 92, .28), transparent 34%),
      linear-gradient(160deg, #06111e, #02070d 72%);
  }
  .g3d-stage:focus-visible {
    box-shadow: inset 0 0 0 3px rgba(124, 205, 0, .62);
  }
  .g3d-stage::before,
  .g3d-stage::after {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    transition: opacity .35s ease;
  }
  .g3d-stage::before {
    opacity: 0;
    background-image:
      radial-gradient(circle at 8% 12%, rgba(255,255,255,.88) 0 1px, transparent 1.5px),
      radial-gradient(circle at 22% 76%, rgba(142,220,232,.8) 0 1px, transparent 1.5px),
      radial-gradient(circle at 38% 26%, rgba(255,255,255,.7) 0 1px, transparent 1.5px),
      radial-gradient(circle at 54% 84%, rgba(255,255,255,.78) 0 1px, transparent 1.5px),
      radial-gradient(circle at 68% 18%, rgba(142,220,232,.72) 0 1px, transparent 1.5px),
      radial-gradient(circle at 83% 62%, rgba(255,255,255,.8) 0 1px, transparent 1.5px),
      radial-gradient(circle at 94% 30%, rgba(255,255,255,.62) 0 1px, transparent 1.5px);
    background-size: 170px 170px, 230px 230px, 310px 310px, 270px 270px, 190px 190px, 290px 290px, 370px 370px;
  }
  .g3d-app.is-stars .g3d-stage::before {
    opacity: .58;
  }
  .g3d-stage::after {
    z-index: 4;
    background: radial-gradient(circle at center, transparent 38%, rgba(0, 5, 12, .38) 100%);
  }
  .g3d-app.is-night .g3d-stage {
    background:
      radial-gradient(circle at 50% 45%, rgba(55, 87, 122, .19), transparent 32%),
      linear-gradient(160deg, #040916, #01040a 72%);
  }
  .g3d-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    opacity: 0;
    transition: opacity .7s ease;
  }
  .g3d-canvas.is-ready {
    opacity: 1;
  }
  .g3d-canvas canvas {
    display: block;
    outline: none;
  }
  .g3d-map-label {
    max-width: 150px;
    padding: 3px 7px;
    border: 1px solid rgba(168, 228, 237, .24);
    border-radius: 11px;
    color: #e8fbff;
    background: rgba(4, 23, 35, .7);
    box-shadow: 0 3px 10px rgba(0, 0, 0, .22);
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 11px;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    transform: translateY(-4px);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
  }
  .g3d-map-label.is-city {
    border-color: rgba(255, 204, 98, .25);
    color: #ffe4a9;
    background: rgba(34, 27, 13, .76);
    font-size: 10px;
  }
  .g3d-map-label.is-landmark {
    border-color: rgba(235, 128, 255, .26);
    color: #f4c7ff;
    background: rgba(40, 13, 45, .76);
    font-size: 10px;
  }
  .g3d-panel {
    position: absolute;
    z-index: 25;
    top: 16px;
    bottom: 54px;
    width: 292px;
    overflow: hidden;
    border: 1px solid var(--g3d-line);
    border-radius: 14px;
    background: var(--g3d-panel);
    box-shadow: 0 16px 38px rgba(0, 0, 0, .28);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    transition: opacity .25s ease, transform .32s cubic-bezier(.2, .72, .21, 1);
  }
  .g3d-layer-panel {
    left: 16px;
    max-height: 520px;
    transform: translateX(calc(-100% - 30px));
    opacity: 0;
    pointer-events: none;
  }
  .g3d-info-panel {
    right: 16px;
    width: 328px;
    transform: translateX(calc(100% + 30px));
    opacity: 0;
    pointer-events: none;
  }
  .g3d-panel.is-open {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }
  .g3d-panel-head {
    display: flex;
    min-height: 54px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 14px;
    border-bottom: 1px solid var(--g3d-line);
    background: rgba(255, 255, 255, .025);
  }
  .g3d-panel-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #eefcff;
    font-size: .9rem;
    font-weight: 600;
  }
  .g3d-panel-title i {
    color: var(--g3d-accent);
  }
  .g3d-panel-close,
  .g3d-guide-close {
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 9px;
  }
  .g3d-panel-body {
    height: calc(100% - 54px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .g3d-layer-list {
    padding: 8px;
  }
  .g3d-layer-switch {
    display: flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    padding: 7px 9px;
    border: 0;
    border-radius: 9px;
    color: #d3e5e9;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .g3d-layer-switch:hover,
  .g3d-layer-switch:focus {
    color: #fff !important;
    background: rgba(255, 255, 255, .055) !important;
    outline: none;
  }
  .g3d-layer-switch:focus-visible {
    box-shadow: inset 0 0 0 2px rgba(124, 205, 0, .65);
  }
  .g3d-layer-switch:disabled {
    opacity: .4;
    cursor: not-allowed;
  }
  .g3d-layer-icon {
    display: grid;
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid rgba(141, 207, 219, .18);
    border-radius: 9px;
    color: #86b3bd;
    background: rgba(255, 255, 255, .035);
  }
  .g3d-layer-name {
    min-width: 0;
    flex: 1;
    font-size: .78rem;
  }
  .g3d-switch-track {
    position: relative;
    flex: 0 0 38px;
    width: 38px;
    height: 22px;
    border: 1px solid rgba(145, 203, 215, .22);
    border-radius: 11px;
    background: rgba(125, 151, 160, .2);
    transition: background .2s ease, border-color .2s ease;
  }
  .g3d-switch-track::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #a8bec5;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .28);
    transition: transform .2s ease, background .2s ease;
  }
  .g3d-layer-switch[aria-checked="true"] .g3d-switch-track {
    border-color: rgba(124, 205, 0, .56);
    background: rgba(90, 150, 0, .5);
  }
  .g3d-layer-switch[aria-checked="true"] .g3d-switch-track::after {
    background: #e5ffc6;
    transform: translateX(16px);
  }
  .g3d-data-status {
    margin: 4px 9px 10px;
    padding: 10px;
    border: 1px solid rgba(145, 203, 215, .13);
    border-radius: 9px;
    color: #8fa9b3;
    background: rgba(255, 255, 255, .025);
    font-size: .68rem;
    line-height: 1.55;
  }
  .g3d-data-status i {
    margin-right: 5px;
    color: #8fc0ca;
  }
  .g3d-data-status.is-error {
    border-color: rgba(255, 137, 113, .28);
    color: #f1b1a5;
    background: rgba(132, 47, 35, .12);
  }
  .g3d-retry-data {
    display: none;
    margin: 8px 0 0;
    padding: 0;
    border: 0;
    color: #cfff96;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }
  .g3d-data-status.is-error .g3d-retry-data {
    display: block;
  }
  .g3d-info-content {
    padding: 16px;
  }
  .g3d-info-eyebrow {
    margin: 0 0 7px;
    color: #83a6b1;
    font-size: .65rem;
    letter-spacing: .11em;
    text-transform: uppercase;
  }
  .g3d-info-heading {
    display: flex;
    align-items: flex-start;
    gap: 11px;
  }
  .g3d-info-emoji {
    display: grid;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(145, 203, 215, .18);
    border-radius: 13px;
    background: rgba(255, 255, 255, .045);
    font-size: 1.55rem;
  }
  .g3d-info-title-wrap {
    min-width: 0;
  }
  .g3d-info-title {
    margin: 1px 0 2px;
    color: #fff;
    font-size: 1.22rem;
    font-weight: 650;
    line-height: 1.25;
  }
  .g3d-info-subtitle {
    margin: 0;
    color: #91aeb8;
    font-size: .73rem;
    line-height: 1.45;
  }
  .g3d-info-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }
  .g3d-info-tag {
    padding: 4px 8px;
    border: 1px solid rgba(124, 205, 0, .2);
    border-radius: 11px;
    color: #c8ee9a;
    background: rgba(124, 205, 0, .07);
    font-size: .64rem;
  }
  .g3d-info-description {
    margin: 14px 0 0;
    color: #bfd0d5;
    font-size: .76rem;
    line-height: 1.72;
  }
  .g3d-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 15px;
  }
  .g3d-info-stat {
    min-width: 0;
    min-height: 63px;
    padding: 9px 10px;
    border: 1px solid rgba(145, 203, 215, .12);
    border-radius: 9px;
    background: rgba(255, 255, 255, .032);
  }
  .g3d-info-stat-label,
  .g3d-info-stat-value {
    display: block;
  }
  .g3d-info-stat-label {
    margin-bottom: 5px;
    color: #7896a0;
    font-size: .61rem;
  }
  .g3d-info-stat-value {
    overflow: hidden;
    color: #edf9fb;
    font-size: .75rem;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
  }
  .g3d-info-note {
    margin: 13px 0 0;
    color: #718d97;
    font-size: .61rem;
    line-height: 1.55;
  }
  .g3d-loader,
  .g3d-fatal {
    position: absolute;
    z-index: 45;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(2, 8, 14, .82);
    transition: opacity .35s ease, visibility .35s ease;
  }
  .g3d-loader.is-hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .g3d-loader-box,
  .g3d-fatal-box {
    max-width: 430px;
    color: #dff6fa;
    text-align: center;
  }
  .g3d-loader-orbit {
    position: relative;
    width: 74px;
    height: 74px;
    margin: 0 auto 17px;
    border: 1px solid rgba(87, 213, 207, .26);
    border-radius: 50%;
  }
  .g3d-loader-orbit::before {
    content: "🌍";
    position: absolute;
    inset: 12px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(14, 92, 112, .22);
    font-size: 1.65rem;
  }
  .g3d-loader-orbit::after {
    content: "";
    position: absolute;
    top: -3px;
    left: 31px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--g3d-accent);
    box-shadow: 0 0 14px rgba(124, 205, 0, .8);
    transform-origin: 6px 40px;
    animation: g3d-orbit 1.6s linear infinite;
  }
  @keyframes g3d-orbit {
    to { transform: rotate(360deg); }
  }
  .g3d-loader-text {
    margin: 0;
    color: #9bb7c0;
    font-size: .8rem;
  }
  .g3d-fatal[hidden] {
    display: none;
  }
  .g3d-fatal-icon {
    display: grid;
    width: 66px;
    height: 66px;
    margin: 0 auto 15px;
    place-items: center;
    border: 1px solid rgba(255, 145, 118, .3);
    border-radius: 50%;
    color: #ff9b81;
    background: rgba(125, 40, 27, .16);
    font-size: 1.45rem;
  }
  .g3d-fatal-title {
    margin: 0 0 8px;
    color: #fff;
    font-size: 1.05rem;
  }
  .g3d-fatal-message {
    margin: 0;
    color: #9db3ba;
    font-size: .78rem;
    line-height: 1.65;
  }
  .g3d-fatal-action {
    min-height: 40px;
    margin-top: 16px;
    padding: 0 18px;
    border: 0;
    border-radius: 8px;
    color: #fff;
    background: linear-gradient(135deg, #5a9600, #7ccd00);
    font: inherit;
    font-size: .78rem;
    cursor: pointer;
  }
  .g3d-guide {
    position: absolute;
    z-index: 18;
    bottom: 70px;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: calc(100% - 36px);
    padding: 10px 10px 10px 14px;
    border: 1px solid rgba(145, 203, 215, .2);
    border-radius: 13px;
    color: #c9dde2;
    background: rgba(7, 22, 37, .78);
    box-shadow: 0 10px 28px rgba(0, 0, 0, .25);
    font-size: .7rem;
    white-space: nowrap;
    transform: translateX(-50%);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: opacity .3s ease, transform .3s ease;
  }
  .g3d-guide.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 10px);
  }
  .g3d-guide-steps {
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .g3d-guide-step i {
    margin-right: 5px;
    color: var(--g3d-accent);
  }
  .g3d-guide-close {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
  }
  .g3d-marker-card {
    position: absolute;
    z-index: 20;
    right: 16px;
    bottom: 62px;
    display: none;
    align-items: center;
    gap: 9px;
    max-width: calc(100% - 32px);
    padding: 9px 10px 9px 12px;
    border: 1px solid rgba(255, 197, 95, .26);
    border-radius: 12px;
    color: #f6e8c6;
    background: rgba(37, 27, 11, .86);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    font-size: .69rem;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .g3d-marker-card.is-visible {
    display: flex;
  }
  .g3d-marker-copy {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .g3d-mini-button {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 8px;
  }
  .g3d-statusbar {
    position: absolute;
    z-index: 17;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    min-height: 42px;
    grid-template-columns: minmax(150px, 1.2fr) minmax(105px, .7fr) minmax(130px, .8fr) minmax(220px, 1.3fr);
    align-items: center;
    border-top: 1px solid var(--g3d-line);
    background: rgba(4, 16, 27, .88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .g3d-status-item {
    min-width: 0;
    padding: 0 12px;
    overflow: hidden;
    border-right: 1px solid rgba(145, 203, 215, .12);
    color: #85a2ac;
    font-size: .65rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .g3d-status-item:last-child {
    border-right: 0;
  }
  .g3d-status-item i {
    margin-right: 6px;
    color: #8dc2cc;
  }
  .g3d-toast {
    position: absolute;
    z-index: 70;
    top: 18px;
    left: 50%;
    max-width: min(480px, calc(100% - 36px));
    padding: 9px 14px;
    border: 1px solid rgba(145, 203, 215, .25);
    border-radius: 11px;
    color: #dff7fb;
    background: rgba(5, 22, 34, .92);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .3);
    font-size: .72rem;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -8px);
    transition: opacity .2s ease, transform .2s ease;
  }
  .g3d-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .g3d-notes {
    margin-top: 12px;
    border: 1px solid #e4ebec;
    border-radius: 9px;
    color: #66767c;
    background: #fafcfc;
    font-size: .78rem;
  }
  .g3d-notes summary {
    padding: 11px 14px;
    color: #53656b;
    font-weight: 600;
    cursor: pointer;
  }
  .g3d-notes-body {
    padding: 0 14px 12px;
    line-height: 1.75;
  }
  .g3d-notes-body p {
    margin: 0 0 6px;
  }
  .g3d-notes-body p:last-child {
    margin-bottom: 0;
  }
  .g3d-notes-body a {
    color: #5a9600;
  }
  .g3d-app:fullscreen,
  .g3d-app:-webkit-full-screen {
    display: flex;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    flex-direction: column;
    border: 0;
    border-radius: 0;
    background: #030a13;
  }
  .g3d-app:fullscreen .g3d-toolbar,
  .g3d-app:-webkit-full-screen .g3d-toolbar {
    padding-top: max(9px, env(safe-area-inset-top));
    padding-right: max(12px, env(safe-area-inset-right));
    padding-left: max(12px, env(safe-area-inset-left));
  }
  .g3d-app:fullscreen .g3d-stage,
  .g3d-app:-webkit-full-screen .g3d-stage {
    height: auto;
    min-height: 0;
    flex: 1;
  }
  .g3d-app:fullscreen .g3d-statusbar,
  .g3d-app:-webkit-full-screen .g3d-statusbar {
    min-height: calc(42px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
  }
  .g3d-app:fullscreen .g3d-panel,
  .g3d-app:-webkit-full-screen .g3d-panel {
    bottom: calc(54px + env(safe-area-inset-bottom));
  }
  .g3d-app:fullscreen .g3d-marker-card,
  .g3d-app:-webkit-full-screen .g3d-marker-card {
    bottom: calc(62px + env(safe-area-inset-bottom));
  }
  .g3d-app:fullscreen .g3d-guide,
  .g3d-app:-webkit-full-screen .g3d-guide {
    bottom: calc(70px + env(safe-area-inset-bottom));
  }
  @media only screen and (max-width: 1100px) {
    .g3d-mode-chip {
      display: none;
    }
    .g3d-toolbar {
      flex-wrap: wrap;
    }
    .g3d-search-wrap {
      order: 1;
      max-width: none;
    }
    .g3d-toolbar-actions {
      order: 2;
    }
  }
  @media only screen and (max-width: 800px) {
    .g3d-stage {
      height: min(720px, 76vh);
      min-height: 620px;
    }
    .g3d-panel {
      top: auto;
      right: 8px;
      bottom: 50px;
      left: 8px;
      width: auto;
      max-height: min(58%, 430px);
      border-radius: 14px 14px 5px 5px;
      transform: translateY(calc(100% + 60px));
    }
    .g3d-layer-panel,
    .g3d-info-panel {
      width: auto;
      transform: translateY(calc(100% + 60px));
    }
    .g3d-panel.is-open {
      transform: translateY(0);
    }
    .g3d-info-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .g3d-guide {
      bottom: 62px;
    }
    .g3d-guide-step:nth-child(3) {
      display: none;
    }
    .g3d-marker-card {
      bottom: 54px;
    }
    .g3d-statusbar {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .g3d-status-item:last-child {
      display: none;
    }
  }
  @media only screen and (max-width: 601px) {
    .g3d-container {
      width: 100%;
      margin-top: -30px;
    }
    .g3d-container > .card > .card-content {
      padding: 7px;
    }
    .g3d-app {
      border-radius: 9px;
    }
    .g3d-toolbar {
      gap: 7px;
      min-height: 108px;
      padding: 8px;
    }
    .g3d-search-wrap {
      flex-basis: calc(100% - 4px);
      width: 100%;
    }
    .g3d-toolbar-actions {
      width: 100%;
      justify-content: space-between;
      margin: 0;
    }
    .g3d-tool-button {
      width: 44px;
      height: 42px;
    }
    .g3d-search-results {
      right: -1px;
      left: -1px;
    }
    .g3d-stage {
      height: 68vh;
      min-height: 560px;
      max-height: 700px;
    }
    .g3d-info-grid {
      grid-template-columns: 1fr 1fr;
    }
    .g3d-guide {
      right: 10px;
      bottom: 58px;
      left: 10px;
      justify-content: center;
      max-width: none;
      white-space: normal;
      transform: none;
    }
    .g3d-guide.is-hidden {
      transform: translateY(10px);
    }
    .g3d-guide-steps {
      justify-content: center;
      gap: 8px;
    }
    .g3d-guide-step:nth-child(2),
    .g3d-guide-step:nth-child(3) {
      display: none;
    }
    .g3d-marker-card {
      right: 8px;
      left: 8px;
      justify-content: center;
      max-width: none;
    }
    .g3d-statusbar {
      grid-template-columns: 1.1fr .8fr .9fr;
    }
    .g3d-status-item {
      padding: 0 7px;
      font-size: .57rem;
      text-align: center;
    }
    .g3d-status-item i {
      display: none;
    }
    .g3d-map-label {
      font-size: 9px;
    }
  }
  @media only screen and (max-width: 960px) and (max-height: 600px) and (orientation: landscape) {
    .g3d-toolbar {
      min-height: 58px;
      flex-wrap: nowrap;
      gap: 7px;
      padding: 7px 8px;
    }
    .g3d-search-wrap,
    .g3d-toolbar-actions {
      order: 0;
    }
    .g3d-search-wrap {
      min-width: 150px;
      flex-basis: auto;
    }
    .g3d-toolbar-actions {
      width: auto;
    }
    .g3d-tool-button {
      width: 38px;
      height: 38px;
    }
    .g3d-stage {
      height: calc(100svh - 66px);
      min-height: 250px;
      max-height: 460px;
    }
    .g3d-panel {
      max-height: calc(100% - 58px);
    }
    .g3d-guide {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .g3d-app *,
    .g3d-app *::before,
    .g3d-app *::after {
      scroll-behavior: auto !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
</style>

<main class="content">
  <div class="container g3d-container">
    <div class="card">
      <%- partial('_partial/tool-header') %>
      <div class="card-content">
        <div class="g3d-app is-stars" id="g3dRoot">
          <p class="g3d-sr-only" id="g3dStageHelp">拖动旋转地球，滚轮或双指缩放。键盘聚焦地球后，可用方向键旋转、加号或减号缩放，也可以使用搜索框查找国家、城市和地标。</p>
          <div class="g3d-sr-only" id="g3dLive" aria-live="polite"></div>

          <div class="g3d-toolbar">
            <span class="g3d-mode-chip"><i class="fas fa-globe-asia"></i>探索模式</span>
            <div class="g3d-search-wrap">
              <label class="g3d-sr-only" for="g3dSearch">搜索国家、城市或地标</label>
              <div class="g3d-search-box">
                <span class="g3d-search-icon"><i class="fas fa-search"></i></span>
                <input
                  class="g3d-search-input"
                  id="g3dSearch"
                  type="search"
                  autocomplete="off"
                  placeholder="搜索国家、城市或地标"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-controls="g3dSearchResults"
                  aria-expanded="false"
                  disabled>
                <button class="g3d-search-clear" id="g3dSearchClear" type="button" aria-label="清空搜索">
                  <i class="fas fa-times"></i>
                </button>
              </div>
              <div class="g3d-search-results" id="g3dSearchResults" role="listbox" aria-label="搜索结果"></div>
            </div>

            <div class="g3d-toolbar-actions">
              <button class="g3d-tool-button" id="g3dAutoRotate" type="button" aria-label="暂停自动旋转" aria-pressed="true" title="自动旋转" disabled>
                <i class="fas fa-sync-alt"></i><span class="g3d-button-label">自动旋转</span>
              </button>
              <button class="g3d-tool-button" id="g3dResetView" type="button" aria-label="恢复默认视角" title="恢复默认视角" disabled>
                <i class="fas fa-home"></i><span class="g3d-button-label">恢复默认视角</span>
              </button>
              <button class="g3d-tool-button" id="g3dLocate" type="button" aria-label="定位我的位置" title="定位我的位置" disabled>
                <i class="fas fa-location-arrow"></i><span class="g3d-button-label">定位我的位置</span>
              </button>
              <button class="g3d-tool-button" id="g3dLayersToggle" type="button" aria-label="打开图层面板" aria-controls="g3dLayerPanel" aria-expanded="false" title="图层" disabled>
                <i class="fas fa-layer-group"></i><span class="g3d-button-label">图层</span>
              </button>
              <button class="g3d-tool-button" id="g3dFullscreen" type="button" aria-label="进入全屏" aria-pressed="false" title="全屏" disabled>
                <i class="fas fa-expand"></i><span class="g3d-button-label">全屏</span>
              </button>
            </div>
          </div>

          <section class="g3d-stage" id="g3dStage" tabindex="0" aria-label="交互式三维地球仪" aria-describedby="g3dStageHelp">
            <div class="g3d-canvas" id="g3dCanvas"></div>

            <div class="g3d-loader" id="g3dLoader" role="status">
              <div class="g3d-loader-box">
                <div class="g3d-loader-orbit"></div>
                <p class="g3d-loader-text" id="g3dLoaderText">正在加载 3D 引擎…</p>
              </div>
            </div>

            <div class="g3d-fatal" id="g3dFatal" role="alert" hidden>
              <div class="g3d-fatal-box">
                <div class="g3d-fatal-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <h3 class="g3d-fatal-title" id="g3dFatalTitle">无法显示三维地球</h3>
                <p class="g3d-fatal-message" id="g3dFatalMessage"></p>
                <button class="g3d-fatal-action" id="g3dReload" type="button"><i class="fas fa-redo-alt"></i> 刷新重试</button>
              </div>
            </div>

            <aside class="g3d-panel g3d-layer-panel" id="g3dLayerPanel" aria-hidden="true" aria-label="图层控制" inert>
              <div class="g3d-panel-head">
                <h3 class="g3d-panel-title"><i class="fas fa-layer-group"></i>图层控制</h3>
                <button class="g3d-panel-close" id="g3dLayerClose" type="button" aria-label="关闭图层面板"><i class="fas fa-times"></i></button>
              </div>
              <div class="g3d-panel-body">
                <div class="g3d-layer-list">
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="true" data-layer="borders">
                    <span class="g3d-layer-icon"><i class="fas fa-draw-polygon"></i></span>
                    <span class="g3d-layer-name">国家边界</span><span class="g3d-switch-track"></span>
                  </button>
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="true" data-layer="countryLabels">
                    <span class="g3d-layer-icon"><i class="fas fa-tags"></i></span>
                    <span class="g3d-layer-name">国家名称</span><span class="g3d-switch-track"></span>
                  </button>
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="true" data-layer="cities">
                    <span class="g3d-layer-icon"><i class="fas fa-city"></i></span>
                    <span class="g3d-layer-name">主要城市</span><span class="g3d-switch-track"></span>
                  </button>
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="true" data-layer="landmarks">
                    <span class="g3d-layer-icon"><i class="fas fa-landmark"></i></span>
                    <span class="g3d-layer-name">精选地标</span><span class="g3d-switch-track"></span>
                  </button>
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="false" data-layer="graticules">
                    <span class="g3d-layer-icon"><i class="fas fa-th"></i></span>
                    <span class="g3d-layer-name">经纬网</span><span class="g3d-switch-track"></span>
                  </button>
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="true" data-layer="atmosphere">
                    <span class="g3d-layer-icon"><i class="fas fa-circle-notch"></i></span>
                    <span class="g3d-layer-name">大气光晕</span><span class="g3d-switch-track"></span>
                  </button>
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="false" data-layer="night">
                    <span class="g3d-layer-icon"><i class="fas fa-moon"></i></span>
                    <span class="g3d-layer-name">夜景地球</span><span class="g3d-switch-track"></span>
                  </button>
                  <button class="g3d-layer-switch" type="button" role="switch" aria-checked="true" data-layer="stars">
                    <span class="g3d-layer-icon"><i class="fas fa-star"></i></span>
                    <span class="g3d-layer-name">星空背景</span><span class="g3d-switch-track"></span>
                  </button>
                </div>
                <div class="g3d-data-status" id="g3dDataStatus">
                  <i class="fas fa-circle-notch fa-spin"></i><span id="g3dDataStatusText">正在加载国家边界数据…</span>
                  <button class="g3d-retry-data" id="g3dRetryData" type="button"><i class="fas fa-redo-alt"></i> 重新加载数据</button>
                </div>
              </div>
            </aside>

            <aside class="g3d-panel g3d-info-panel" id="g3dInfoPanel" aria-hidden="true" aria-label="地理信息" inert>
              <div class="g3d-panel-head">
                <h3 class="g3d-panel-title"><i class="fas fa-info-circle"></i>地理信息</h3>
                <button class="g3d-panel-close" id="g3dInfoClose" type="button" aria-label="关闭信息面板"><i class="fas fa-times"></i></button>
              </div>
              <div class="g3d-panel-body">
                <div class="g3d-info-content" id="g3dInfoContent"></div>
              </div>
            </aside>

            <div class="g3d-guide" id="g3dGuide" aria-hidden="false">
              <div class="g3d-guide-steps">
                <span class="g3d-guide-step"><i class="fas fa-hand-pointer"></i>拖动旋转</span>
                <span class="g3d-guide-step"><i class="fas fa-search-plus"></i>滚轮或双指缩放</span>
                <span class="g3d-guide-step"><i class="fas fa-map-marker-alt"></i>点击国家查看信息</span>
              </div>
              <button class="g3d-guide-close" id="g3dGuideClose" type="button" aria-label="关闭操作引导"><i class="fas fa-times"></i></button>
            </div>

            <div class="g3d-marker-card" id="g3dMarkerCard" aria-hidden="true" inert>
              <i class="fas fa-map-pin"></i>
              <span class="g3d-marker-copy" id="g3dMarkerCoords">—</span>
              <button class="g3d-mini-button" id="g3dCopyCoords" type="button" aria-label="复制坐标" title="复制坐标"><i class="fas fa-copy"></i></button>
              <button class="g3d-mini-button" id="g3dClearMarker" type="button" aria-label="清除坐标标记" title="清除标记"><i class="fas fa-trash-alt"></i></button>
            </div>

            <div class="g3d-toast" id="g3dToast" role="status"></div>

            <div class="g3d-statusbar" aria-label="地球状态">
              <div class="g3d-status-item"><i class="fas fa-crosshairs"></i><span id="g3dPointerCoords">移动指针查看经纬度</span></div>
              <div class="g3d-status-item"><i class="fas fa-search-location"></i><span id="g3dZoomStatus">全球视角</span></div>
              <div class="g3d-status-item"><i class="far fa-clock"></i><span id="g3dUtcTime">--:--:-- UTC</span></div>
              <div class="g3d-status-item"><i class="fas fa-mouse-pointer"></i><span id="g3dStatusHint">正在初始化地球…</span></div>
            </div>
          </section>
        </div>

        <details class="g3d-notes">
          <summary>数据来源与使用说明</summary>
          <div class="g3d-notes-body">
            <p>三维渲染使用固定版本 <a href="https://globe.gl/" target="_blank" rel="noopener noreferrer">Globe.gl 2.46.1</a>；国家边界与人口估算来自 <a href="https://www.naturalearthdata.com/" target="_blank" rel="noopener noreferrer">Natural Earth 110m</a> 数据集，人口年份会随国家信息单独标注。日间、夜景与凹凸纹理采用 three-globe 示例资源，加载失败时会自动切换备用 CDN 或降级为纯色地球。边界采用数据集的可视化口径，不用于法律或行政判断。</p>
            <p>城市与地标是用于探索和搜索的精选本地数据，并非全量目录；夜景模式为静态夜间纹理，不代表实时昼夜分布。</p>
          </div>
        </details>
      </div>
    </div>

    <div class="card">
      <% if (theme.valine && theme.valine.enable) { %>
      <%- partial('_partial/valine') %>
      <% } %>
    </div>
  </div>
</main>

<script
  src="https://cdn.jsdelivr.net/npm/globe.gl@2.46.1/dist/globe.gl.min.js"
  onerror="this.onerror=null;this.src='https://unpkg.com/globe.gl@2.46.1/dist/globe.gl.min.js';"></script>

<script>
(function() {
  'use strict';

  var root = document.getElementById('g3dRoot');
  if (!root || window.__meowv3dGlobeInitialized) return;
  window.__meowv3dGlobeInitialized = true;

  var q = function(selector) { return root.querySelector(selector); };
