      twiceArea += cross;
      cx += (points[i][0] + points[i + 1][0]) * cross;
      cy += (points[i][1] + points[i + 1][1]) * cross;
    }
    var area = twiceArea / 2;
    if (!isFinite(area) || Math.abs(area) < .000001) {
