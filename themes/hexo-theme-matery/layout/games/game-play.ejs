<%
    var gameTitle = page.gameName || page.title;
    var gameDesc = '';
    if (site.data && site.data.games) {
        var game = site.data.games.find(function(g) { return g.slug === page.gameSlug; });
        if (game) {
            gameTitle = game.emoji + ' ' + game.name;
            gameDesc = game.description;
        }
    }
%>
<style>
    .game-play-container {
        margin-top: 20px;
        margin-bottom: 30px;
    }
    .game-play-header {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }
    .game-play-container .game-play-title {
        color: #3C4858;
        font-size: 1.4rem;
        font-weight: 400;
    }
    .game-iframe-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        background: #1a1a2e;
        border-radius: 8px;
        overflow: hidden;
    }
    .game-iframe-wrapper iframe {
        border: none;
        width: 100%;
        height: 800px;
        max-width: 100%;
        overflow: hidden;
    }

    @media only screen and (max-width: 601px) {
        .game-iframe-wrapper iframe {
            height: 550px;
        }
    }

    header .nav-transparent {
        background-image: linear-gradient(to right, #5a9600 0%, #4cbf30 50%, #0A3E1E 100%) !important;
    }
</style>

<main class="content">
    <div class="container game-play-container">
        <div class="card">
            <div class="card-content">
                <div class="game-play-header">
                    <span class="game-play-title"><%= gameTitle %></span>
                    <% if (gameDesc) { %>
                    <span style="color: #999; font-size: 0.9rem; margin-left: 8px;"><%= gameDesc %></span>
                    <% } %>
                </div>

                <div class="game-iframe-wrapper">
                    <iframe src="/games/<%= page.gameSlug %>/<%= page.gameEntry || 'index.html' %>"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
                            sandbox="allow-scripts allow-same-origin"
                            scrolling="no">
                    </iframe>
                </div>
            </div>
        </div>

        <% if (page.content && page.content.length > 0) { %>
        <div class="card">
            <div class="card-content">
                <%- page.content %>
            </div>
        </div>
        <% } %>

        <div class="card">
            <% if (theme.valine && theme.valine.enable) { %>
            <%- partial('_partial/valine') %>
            <% } %>
        </div>
    </div>
</main>