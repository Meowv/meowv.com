<style>
    .game-play-container {
        margin-top: 20px;
        margin-bottom: 30px;
    }
    .game-play-header {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }
    .game-play-container .game-play-title {
        color: #3C4858;
        font-size: 1.4rem;
        font-weight: 400;
    }
    .game-iframe-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        background: #1a1a2e;
        border-radius: 8px;
        overflow: hidden;
    }
    .game-iframe-wrapper iframe {
        border: none;
        width: 100%;
        height: 800px;
        max-width: 100%;
        overflow: hidden;
    }
    .game-back-arrow {
        color: #3C4858;
        font-size: 1.2rem;
        text-decoration: none;
        transition: color 0.3s;
        margin-right: 8px;
        line-height: 1;
    }
    .game-back-arrow:hover {
        color: #4facfe;
        text-decoration: none;
    }

    @media only screen and (max-width: 601px) {
        .game-iframe-wrapper iframe {
            height: 550px;
        }
    }

    header .nav-transparent {
        background-image: linear-gradient(to right, #5a9600 0%, #4cbf30 50%, #0A3E1E 100%) !important;
    }
</style>

<main class="content">
    <div class="container game-play-container">
        <div class="card">
            <div class="card-content">
                <div class="game-play-header">
                    <a href="/game/" class="game-back-arrow">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span class="game-play-title"><%= page.gameName || page.title %></span>
                </div>

                <div class="game-iframe-wrapper">
                    <iframe src="/games/<%= page.gameSlug %>/<%= page.gameEntry || 'index.html' %>"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
                            sandbox="allow-scripts allow-same-origin"
                            scrolling="no">
                    </iframe>
                </div>
            </div>
        </div>

        <% if (page.content && page.content.length > 0) { %>
        <div class="card">
            <div class="card-content">
                <%- page.content %>
            </div>
        </div>
        <% } %>

        <div class="card">
            <% if (theme.valine && theme.valine.enable) { %>
            <%- partial('_partial/valine') %>
            <% } %>
        </div>
    </div>
</main>