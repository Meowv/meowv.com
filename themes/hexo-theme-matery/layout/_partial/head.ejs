<%
    var title = page.title;

    // tags, categories, about, contact, friends pages title
    if (title == 'tags') {
        title = __('tags');
    } else if (title == 'categories') {
        title = __('categories');
    } else if (title == 'about') {
        title = __('about');
    } else if (title == 'contact') {
        title = __('contact');
    } else if (title == 'friends') {
        title = __('friends');
    } else if (title == 'games') {
        title = __('games');
    } else if (title == 'labs') {
        title = __('labs');
    }

    // archives, category, tag pages title
    if (is_archive()) {
        title = __('archives');
        if (is_month()) {
            title += ': ' + page.year + '/' + page.month;
        } else if (is_year()) {
            title += ': ' + page.year;
        }
    } else if (is_category()) {
        title = __('category') + ': ' + page.category;
    } else if (is_tag()) {
        title = __('tag') + ': ' + page.tag;
    }

    // final page title.
    var pageTitle = title ? title + ' | ' + config.title : config.title;

    // keywords.
    var keyWords = config.keywords ? config.keywords : config.title;
    if (page.keywords) {
        keyWords = page.keywords;
    } else {
    	keyWords = title ? title  + ', ' + keyWords : keyWords;
    }

    // 页面 SEO 信息。
    var toolData = null;
    if (page.toolSlug && site.data && site.data.tools) {
        toolData = site.data.tools.find(function (tool) {
            return tool.slug === page.toolSlug;
        });
    }

    var description = page.description || (toolData && toolData.description) || page.summary;
    if (!description && page.hasOwnProperty('__post') && page.__post) {
        description = strip_html(page.content).substring(0, 160);
    }
    description = strip_html(description || config.description || pageTitle)
        .replace(/\s+/g, ' ')
        .trim();

    var siteUrl = config.url.replace(/\/+$/, '');
    var canonicalPath = page.path ? url_for(page.path) : url_for('/');
    canonicalPath = canonicalPath.replace(/index\.html$/, '');
    var canonicalUrl = siteUrl + canonicalPath;
    var isNotFoundPage = page.path === '404.html';
    var isPostPage = page.hasOwnProperty('__post') && page.__post;

    var absoluteUrl = function (value) {
        if (/^https?:\/\//i.test(value)) {
            return value;
        }
        return siteUrl + url_for(value);
    };

    var socialImage = absoluteUrl(page.img || '/medias/logo.png');
    var structuredData = {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: pageTitle,
        description: description,
        url: canonicalUrl,
        isPartOf: {
            '@type': 'WebSite',
            name: config.title,
            url: siteUrl + '/'
        }
    };

    if (isPostPage) {
        structuredData = {
            '@context': 'https://schema.org',
            '@type': 'BlogPosting',
            headline: title || pageTitle,
            description: description,
            url: canonicalUrl,
            mainEntityOfPage: canonicalUrl,
            image: socialImage,
            author: {
                '@type': 'Person',
                name: page.author || config.author,
                url: siteUrl + '/about/'
            },
            publisher: {
                '@type': 'Person',
                name: config.author,
                url: siteUrl + '/about/'
            },
            datePublished: page.date && page.date.toISOString
                ? page.date.toISOString()
                : undefined
        };
    } else if (toolData) {
        structuredData = {
            '@context': 'https://schema.org',
            '@type': 'WebApplication',
            name: toolData.name,
            description: description,
            url: canonicalUrl,
            applicationCategory: 'UtilitiesApplication',
            operatingSystem: 'Any',
            browserRequirements: 'Requires JavaScript',
            offers: {
                '@type': 'Offer',
                price: '0',
                priceCurrency: 'CNY'
            }
        };
    } else if (page.type === 'labs' || page.layout === 'labs') {
        structuredData['@type'] = 'CollectionPage';
    } else if (canonicalPath === '/') {
        structuredData = {
            '@context': 'https://schema.org',
            '@type': 'WebSite',
            name: config.title,
            alternateName: '阿星Plus',
            description: description,
            url: canonicalUrl,
            inLanguage: config.language
        };
    }

    var structuredDataJson = JSON.stringify(structuredData)
        .replace(/</g, '\\u003c');

    let iconType = 'image/png'
    let faviconExt = theme.favicon.substr(theme.favicon.lastIndexOf('.') + 1, theme.favicon.length)
    if (faviconExt === 'png') {
        iconType = 'image/png'
    } else if (faviconExt === 'svg') {
        iconType = 'image/svg+xml'
    } else if (faviconExt === 'gif') {
        iconType = 'image/gif'
    } else if (faviconExt === 'jpeg') {
        iconType = 'image/jpeg'
    } else if (faviconExt === 'jpg') {
        iconType = 'image/jpeg'
    } else if (faviconExt === 'ico') {
        iconType = 'image/x-icon, image/vnd.microsoft.icon'
    }
%>

<head>
    <meta charset="utf-8">
    <meta name="keywords" content="<%= keyWords %>">
    <meta name="description" content="<%= description %>">
    <% if (isNotFoundPage) { %>
    <meta name="robots" content="noindex, follow">
    <% } else { %>
    <link rel="canonical" href="<%= canonicalUrl %>">
    <% } %>
    <meta property="og:type" content="<%= isPostPage ? 'article' : 'website' %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:image" content="<%= socialImage %>">
    <meta property="og:locale" content="zh_CN">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= socialImage %>">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="renderer" content="webkit|ie-stand|ie-comp">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%- partial('_partial/google-analytics') %>
    <title><%= pageTitle %></title>
    <script type="application/ld+json"><%- structuredDataJson %></script>
    <link rel="icon" type="<%= iconType %>" href="<%- theme.cdn.url %><%- url_for(theme.favicon) %>">

    <link rel="stylesheet" type="text/css" href="<%- theme.cdn.url %><%- url_for(theme.libs.css.fontAwesome) %>">
    <link rel="stylesheet" type="text/css" href="<%- theme.cdn.url %><%- url_for(theme.libs.css.materialize) %>">
    <link rel="stylesheet" type="text/css" href="<%- theme.cdn.url %><%- url_for(theme.libs.css.aos) %>">
    <link rel="stylesheet" type="text/css" href="<%- theme.cdn.url %><%- url_for(theme.libs.css.animate) %>">
    <link rel="stylesheet" type="text/css" href="<%- theme.cdn.url %><%- url_for(theme.libs.css.lightgallery) %>">
    <link rel="stylesheet" type="text/css" href="<%- theme.cdn.url %><%- url_for(theme.libs.css.matery) %>">
    <link rel="stylesheet" type="text/css" href="<%- theme.cdn.url %><%- url_for(theme.libs.css.mycss) %>">

    <script src="<%- theme.cdn.url %><%- url_for(theme.libs.js.jquery) %>"></script>

</head>
