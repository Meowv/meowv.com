  var grid = document.getElementById('ptGrid');
  var searchInput = document.getElementById('ptSearch');
  var legendEl = document.getElementById('ptLegend');
  var detailEl = document.getElementById('ptDetail');

  var activeCat = null;
  var selectedEl = null;

  function renderGrid() {
    grid.innerHTML = '';
    for (var r = 1; r <= 9; r++) {
      for (var c = 1; c <= 18; c++) {
        var cell = document.createElement('div');
        cell.className = 'pt-cell';
        cell.style.gridColumn = c;
        cell.style.gridRow = r;

        var el = elements.filter(function(e) { return e.x === c && e.y === r; })[0];
        if (el) {
          cell.dataset.n = el.n;
          cell.dataset.c = el.c;
          cell.style.background = catColors[el.c];
          cell.innerHTML = '<span class="pt-number">' + el.n + '</span>' +
            '<span class="pt-symbol">' + el.s + '</span>' +
            '<span class="pt-name">' + el.na + '</span>';
          cell.addEventListener('click', (function(elem) {
            return function() { selectElement(elem); };
          })(el));
        } else {
          cell.className += ' pt-empty';
          var isEmptyBlock = (r === 6 || r === 7) && c >= 4 && c <= 17;
          if (isEmptyBlock) {
            cell.style.background = 'transparent';
          }
        }
        grid.appendChild(cell);
      }
    }

    renderLegend();
  }

  function renderLegend() {
    legendEl.innerHTML = '';
    catOrder.forEach(function(cat) {
      var item = document.createElement('span');
      item.className = 'pt-legend-item';
      item.dataset.cat = cat;
      item.innerHTML = '<span class="pt-legend-dot" style="background:' + catColors[cat] + '"></span>' + catNames[cat];
      item.addEventListener('click', function() {
        if (activeCat === cat) {
          activeCat = null;
          item.classList.remove('active');
        } else {
          activeCat = cat;
          document.querySelectorAll('.pt-legend-item').forEach(function(el) { el.classList.remove('active'); });
          item.classList.add('active');
        }
        applyFilter();
      });
      legendEl.appendChild(item);
    });
  }

  function applyFilter() {
    var query = searchInput.value.trim().toLowerCase();
    var cells = grid.querySelectorAll('.pt-cell:not(.pt-empty)');
    cells.forEach(function(cell) {
      var n = parseInt(cell.dataset.n);
      var el = elements.filter(function(e) { return e.n === n; })[0];
      if (!el) return;
      var matchCat = !activeCat || el.c === activeCat;
      var matchSearch = !query ||
        el.na.includes(query) ||
        el.s.toLowerCase().includes(query) ||
        el.n.toString() === query;
      if (matchCat && matchSearch) {
        cell.classList.remove('dimmed');
        cell.classList.add('highlight');
      } else {
        cell.classList.add('dimmed');
        cell.classList.remove('highlight');
      }
    });
  }

  function clearFilter() {
    searchInput.value = '';
    activeCat = null;
    document.querySelectorAll('.pt-legend-item').forEach(function(el) { el.classList.remove('active'); });
    var cells = grid.querySelectorAll('.pt-cell:not(.pt-empty)');
    cells.forEach(function(cell) {
      cell.classList.remove('dimmed', 'highlight');
    });
  }

  function selectElement(el) {
    selectedEl = el;
    detailEl.className = 'pt-detail visible';
    detailEl.style.borderColor = catColors[el.c];
    detailEl.innerHTML =
      '<div class="pt-detail-header">' +
        '<div class="pt-detail-symbol" style="color:' + catColors[el.c] + '">' + el.s + '</div>' +
        '<div class="pt-detail-info">' +
          '<div class="pt-detail-name">' + el.na + '</div>' +
          '<div class="pt-detail-sub">原子序数 ' + el.n + ' &middot; ' + catNames[el.c] + '</div>' +
          '<span class="pt-detail-badge" style="background:' + catColors[el.c] + '">' + catNames[el.c] + '</span>' +
        '</div>' +
      '</div>' +
      '<div class="pt-detail-meta">' +
        '<div class="pt-detail-meta-item">' +
          '<span class="pt-detail-meta-label">原子序数</span>' +
          '<span class="pt-detail-meta-value">' + el.n + '</span>' +
        '</div>' +
        '<div class="pt-detail-meta-item">' +
          '<span class="pt-detail-meta-label">相对原子质量</span>' +
          '<span class="pt-detail-meta-value">' + el.m + '</span>' +
        '</div>' +
        '<div class="pt-detail-meta-item">' +
          '<span class="pt-detail-meta-label">元素符号</span>' +
          '<span class="pt-detail-meta-value">' + el.s + '</span>' +
        '</div>' +
        '<div class="pt-detail-meta-item">' +
          '<span class="pt-detail-meta-label">周期</span>' +
          '<span class="pt-detail-meta-value">' + (el.y <= 7 ? el.y : (el.y === 8 ? '6' : '7')) + '</span>' +
        '</div>' +
        '<div class="pt-detail-meta-item">' +
          '<span class="pt-detail-meta-label">族</span>' +
          '<span class="pt-detail-meta-value">' + el.x + '</span>' +
        '</div>' +
      '</div>';
    window.scrollTo({ top: detailEl.offsetTop + detailEl.parentElement.offsetTop - 120, behavior: 'smooth' });
  }

  searchInput.addEventListener('input', function() {
    activeCat = null;
    document.querySelectorAll('.pt-legend-item').forEach(function(el) { el.classList.remove('active'); });
    applyFilter();
  });

  renderGrid();
})();
</script>
