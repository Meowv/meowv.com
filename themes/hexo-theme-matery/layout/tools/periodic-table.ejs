<%
    var toolTitle = '元素周期表';
    var toolDesc = '';
    if (site.data && site.data.tools) {
        var tool = site.data.tools.find(function(t) { return t.slug === page.toolSlug; });
        if (tool) {
            toolTitle = tool.emoji + ' ' + tool.name;
            toolDesc = tool.description;
        }
    }
%>
<%- partial('_partial/bg-cover') %>

<style>
  .tool-container { margin-top: -50px; margin-bottom: 30px; }
  .tool-container .card { border-radius: 8px; }

  .pt-controls {
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
    margin-bottom: 20px;
  }
  .pt-search {
    flex: 1; min-width: 160px; padding: 8px 14px; border: 2px solid #e0e0e0;
    border-radius: 8px; font-size: 0.9rem; outline: none; transition: border-color 0.3s;
    background: #fafafa;
  }
  .pt-search:focus { border-color: #7c4dff; background: #fff; }
  .pt-search::-webkit-input-placeholder { color: #bbb; }

  .pt-legend {
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .pt-legend-item {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 14px; font-size: 0.72rem;
    cursor: pointer; transition: all 0.2s; border: 2px solid transparent;
    user-select: none; white-space: nowrap;
  }
  .pt-legend-item:hover { opacity: 0.8; }
  .pt-legend-item.active { border-color: #333; box-shadow: 0 0 0 1px #fff; }
  .pt-legend-item .pt-legend-dot {
    width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
  }

  .pt-grid-wrap {
    overflow-x: auto; margin-bottom: 16px;
  }
  .pt-grid {
    display: grid;
    grid-template-columns: repeat(18, 1fr);
    gap: 3px;
    min-width: 680px;
  }

  .pt-cell {
    position: relative; border-radius: 4px; padding: 4px 2px;
    text-align: center; cursor: pointer; transition: all 0.15s;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: 58px; color: #fff; overflow: hidden;
  }
  .pt-cell:hover { transform: scale(1.15); z-index: 2; box-shadow: 0 4px 16px rgba(0,0,0,0.3); }
  .pt-cell .pt-number { font-size: 0.55rem; opacity: 0.85; line-height: 1; position: absolute; top: 2px; left: 4px; }
  .pt-cell .pt-symbol { font-size: 1.05rem; font-weight: 700; line-height: 1.2; }
  .pt-cell .pt-name { font-size: 0.5rem; opacity: 0.9; line-height: 1; }
  .pt-cell .pt-mass { font-size: 0.45rem; opacity: 0.7; line-height: 1; }

  .pt-cell.dimmed { opacity: 0.2; }
  .pt-cell.highlight { transform: scale(1.08); z-index: 1; box-shadow: 0 0 0 2px #fff, 0 0 16px rgba(124,77,255,0.5); }

  .pt-empty { pointer-events: none; }
  .pt-fblock-label {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-size: 0.6rem; color: #999; font-weight: 600;
  }

  .pt-detail {
    display: none; margin-top: 16px; padding: 20px; border-radius: 10px;
    background: linear-gradient(135deg, #f8f9fa, #e9ecef); transition: all 0.3s;
    border-left: 5px solid #7c4dff;
  }
  .pt-detail.visible { display: block; }
  .pt-detail .pt-detail-header {
    display: flex; align-items: center; gap: 16px; margin-bottom: 12px;
  }
  .pt-detail .pt-detail-symbol {
    font-size: 2.8rem; font-weight: 800; line-height: 1; color: #333;
  }
  .pt-detail .pt-detail-info { flex: 1; }
  .pt-detail .pt-detail-name {
    font-size: 1.4rem; font-weight: 600; color: #222;
  }
  .pt-detail .pt-detail-sub {
    font-size: 0.85rem; color: #666; margin-top: 2px;
  }
  .pt-detail .pt-detail-meta {
    display: flex; flex-wrap: wrap; gap: 16px; margin-top: 8px;
  }
  .pt-detail .pt-detail-meta-item {
    display: flex; flex-direction: column;
  }
  .pt-detail .pt-detail-meta-label {
    font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: #999;
  }
  .pt-detail .pt-detail-meta-value {
    font-size: 1rem; font-weight: 600; color: #333;
  }
  .pt-detail .pt-detail-badge {
    display: inline-block; padding: 2px 12px; border-radius: 12px;
    font-size: 0.75rem; font-weight: 600; color: #fff; margin-top: 4px;
  }

  @media only screen and (max-width: 768px) {
    .tool-container { margin-top: -30px; }
    .pt-cell { min-height: 42px; padding: 2px 1px; }
    .pt-cell .pt-number { font-size: 0.45rem; }
    .pt-cell .pt-symbol { font-size: 0.8rem; }
    .pt-cell .pt-name { display: none; }
    .pt-cell .pt-mass { display: none; }
    .pt-grid { gap: 2px; min-width: 540px; }
    .pt-detail { padding: 14px; }
    .pt-detail .pt-detail-symbol { font-size: 2rem; }
  }
  @media only screen and (max-width: 601px) {
    .pt-cell { min-height: 34px; }
    .pt-cell .pt-number { font-size: 0.35rem; top: 1px; left: 2px; }
    .pt-cell .pt-symbol { font-size: 0.65rem; }
    .pt-grid { gap: 1.5px; min-width: 400px; }
    .pt-legend-item { font-size: 0.6rem; padding: 2px 6px; }
  }
</style>

<main class="content">
  <div class="container tool-container">
    <div class="card">
      <%- partial('_partial/tool-header', { toolTitle: toolTitle, toolDesc: toolDesc }) %>
      <div class="card-content">
        <div class="pt-controls">
          <input class="pt-search" type="text" id="ptSearch" placeholder="搜索元素名称或符号...">
          <div class="pt-legend" id="ptLegend"></div>
        </div>

        <div class="pt-grid-wrap">
          <div class="pt-grid" id="ptGrid"></div>
        </div>

        <div class="pt-detail" id="ptDetail"></div>
      </div>
    </div>

    <div class="card">
      <% if (theme.valine && theme.valine.enable) { %>
      <%- partial('_partial/valine') %>
      <% } %>
    </div>
  </div>
</main>

