                <label class="answer-book-setting-label" for="answerBookQuestion">想问的问题 <small>可选</small></label>
                <textarea id="answerBookQuestion" class="answer-book-question" maxlength="200" placeholder="写下你的问题，也可以只放在心里"></textarea>
                <label class="answer-book-setting-label">答案主题</label>
                <div class="answer-book-theme-row" id="answerBookThemes" aria-label="答案主题"></div>
                <div class="answer-book-toolbar">
                  <button type="button" class="answer-book-primary" id="answerBookOpen"><i class="fas fa-book-open"></i>翻开答案之书</button>
                  <div class="answer-book-tools">
                    <button type="button" class="answer-book-icon-button" id="answerBookHistory"><i class="fas fa-history"></i>历史</button>
                  </div>
                </div>
              </div>
            </section>
            <section class="answer-book-panel answer-book-result-panel" aria-labelledby="answerBookResultTitle">
              <div class="answer-book-result-head">
                <span class="answer-book-result-title" id="answerBookResultTitle"><i class="fas fa-book-reader"></i>翻阅结果</span>
                <span class="answer-book-status" id="answerBookResultStatus">等待翻阅</span>
              </div>
              <div class="answer-book-stage">
                <div id="answerBook" class="answer-book" role="button" tabindex="0" aria-label="翻开答案之书">
                  <div class="answer-book-leaf answer-book-left-page" aria-hidden="true"><span class="answer-book-page-mark">静候 · 翻阅</span></div>
                  <div class="answer-book-leaf answer-book-right-page">
                    <div class="answer-book-answer"><p id="answerBookAnswer"></p><small id="answerBookSource">—— 人生答案之书</small></div>
                  </div>
                  <div class="answer-book-turning-page" aria-hidden="true">
                    <div class="answer-book-page-face answer-book-page-front"><span class="answer-book-page-whisper">轻轻翻开这一页</span><div class="answer-book-turning-answer"><p id="answerBookTurningAnswer"></p><small id="answerBookTurningSource"></small></div></div>
                    <div class="answer-book-page-face answer-book-page-back"></div>
                  </div>
                  <div class="answer-book-cover">
                    <div class="answer-book-cover-face answer-book-cover-front"><small id="answerBookCoverSub">给愿意慢慢生活的人</small><strong>答案之书</strong><span id="answerBookCoverTheme">人生</span></div>
                    <div class="answer-book-cover-face answer-book-cover-back"><span class="answer-book-ex-libris">答案一直在路上</span></div>
                  </div>
                  <span class="answer-book-spine" aria-hidden="true"></span>
                </div>
                <p class="answer-book-hint" id="answerBookHint">请在心中默念一个问题</p>
              </div>
              <div class="answer-book-actions" id="answerBookActions">
                <button type="button" class="answer-book-action" id="answerBookAgain"><i class="fas fa-redo"></i>再问一次</button>
                <button type="button" class="answer-book-action" id="answerBookCopy"><i class="far fa-copy"></i>复制答案</button>
                <button type="button" class="answer-book-action" id="answerBookShare"><i class="fas fa-share-alt"></i>分享卡片</button>
                <button type="button" class="answer-book-action" id="answerBookClose"><i class="fas fa-book"></i>合上书</button>
              </div>
              <p id="answerBookNotice" class="answer-book-notice" aria-live="polite"></p>
            </section>
          </div>
        </div>
      </div>
    </div>
    <div class="card answer-book-comments"><% if (theme.valine && theme.valine.enable) { %><%- partial('_partial/valine') %><% } %></div>
  </div>
</main>

<div class="answer-book-drawer" id="answerBookHistoryDrawer" aria-hidden="true"><div class="answer-book-drawer-panel" role="dialog" aria-modal="true" aria-label="本地历史记录" tabindex="-1"><div class="answer-book-dialog-title"><h4>本地历史</h4><button type="button" class="answer-book-close" data-close="answerBookHistoryDrawer" aria-label="关闭">×</button></div><div id="answerBookHistoryList"></div><button type="button" class="answer-book-danger" id="answerBookClearHistory">清空全部记录</button></div></div>
<div class="answer-book-drawer answer-book-share-drawer" id="answerBookShareDrawer" aria-hidden="true">
  <div class="answer-book-drawer-panel answer-book-share-panel" role="dialog" aria-modal="true" aria-labelledby="answerBookShareTitle" tabindex="-1">
    <div class="answer-book-dialog-title"><h4 id="answerBookShareTitle">答案明信片</h4><button type="button" class="answer-book-close" data-close="answerBookShareDrawer" aria-label="关闭">×</button></div>
    <div class="answer-book-share-preview"><canvas id="answerBookShareCanvas" width="1600" height="1000" role="img" aria-label="答案之书分享卡片预览"></canvas></div>
    <div class="answer-book-share-controls">
      <div class="answer-book-share-question" id="answerBookShareQuestionOption" hidden><span>在卡片中显示问题</span><button type="button" class="answer-book-switch" id="answerBookShareQuestionToggle" role="switch" aria-checked="true" aria-label="在卡片中显示问题"></button></div>
      <a class="answer-book-download" id="answerBookDownload" aria-disabled="true"><i class="fas fa-download"></i>下载 PNG</a>
    </div>
    <p class="answer-book-share-note" id="answerBookShareNotice" aria-live="polite">正在制作你的答案明信片…</p>
  </div>
</div>
<div class="answer-book-qr-source" id="answerBookQrSource" aria-hidden="true"></div>
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
  (function() {
    var rawAnswers = <%- JSON.stringify(site.data['answer-book'] || {}) %>;
    var themes = [
      { id: 'life', name: '人生', subtitle: '给愿意慢慢生活的人' }, { id: 'love', name: '爱情', subtitle: '给认真感受的人' },
      { id: 'career', name: '职场', subtitle: '给正在前进的人' }, { id: 'developer', name: '程序员', subtitle: '给解决问题的人' },
      { id: 'today', name: '今日指引', subtitle: '给今天的你' }, { id: 'midnight', name: '深夜时刻', subtitle: '给还没入睡的人' }
    ];
    var answers = {};
    themes.forEach(function(theme) { answers[theme.id] = (rawAnswers[theme.id] || []).map(function(item, index) { return typeof item === 'string' ? { id: theme.id + '-' + (index + 1), theme: theme.id, text: item, tone: ['gentle', 'positive', 'action', 'caution', 'humor'][index % 5] } : item; }); });
    var keys = { user: 'meowv:answer-book:user', history: 'meowv:answer-book:history', recent: 'meowv:answer-book:recent' };
    var shareUrl = 'https://meowv.com/tools/answer-book';
    var state = { theme: 'life', mode: 'random', answer: null, question: '', answeredAt: null, phase: 'closed', motionToken: 0, storage: true, history: [], recent: [], shareQuestion: true, shareReady: false, shareRenderToken: 0, shareDownloadUrl: '', shareDownloadObjectUrl: false, layerTrigger: null };
    var $book = $('#answerBook'), $answer = $('#answerBookAnswer'), $notice = $('#answerBookNotice'), $resultStatus = $('#answerBookResultStatus');
    var $turningPage = $('.answer-book-turning-page'), $turningAnswer = $('#answerBookTurningAnswer'), $turningSource = $('#answerBookTurningSource');
    function read(key, fallback) { try { var value = localStorage.getItem(key); return value ? JSON.parse(value) : fallback; } catch (error) { state.storage = false; return fallback; } }
    function write(key, value) { if (!state.storage) return; try { localStorage.setItem(key, JSON.stringify(value)); } catch (error) { state.storage = false; showNotice('本地记录暂时不可用，答案仍可正常翻阅。'); } }
    function showNotice(text) { $notice.text(text); clearTimeout(showNotice.timer); showNotice.timer = setTimeout(function() { $notice.text(''); }, 2600); }
    function setResultStatus(text) { $resultStatus.text(text); }
    function randomId() { return String(Date.now()) + '-' + Math.random().toString(36).slice(2, 8); }
    function getUserId() { var id = read(keys.user, ''); if (!id) { id = randomId(); write(keys.user, id); } return id; }
    function hash(text) { var value = 2166136261; for (var i = 0; i < text.length; i++) { value ^= text.charCodeAt(i); value += (value << 1) + (value << 4) + (value << 7) + (value << 8) + (value << 24); } return value >>> 0; }
    function todayKey() { var date = new Date(); return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0'); }
    function currentTheme(id) { return themes.filter(function(item) { return item.id === (id || state.theme); })[0] || themes[0]; }
    function isReducedMotion() { return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches; }
    function isBusy() { return state.phase === 'opening' || state.phase === 'turning' || state.phase === 'closing'; }
    function getAnswer() {
      var list = answers[state.theme] || [];
      if (!list.length) { showNotice('答案之书暂时没有可翻阅的内容。'); return null; }
      if (state.mode === 'daily') { return list[hash(todayKey() + ':' + getUserId() + ':' + state.theme) % list.length]; }
      var recent = state.recent.filter(function(item) { return item.theme === state.theme; }).slice(0, 5).map(function(item) { return item.answerId; });
      var candidates = list.filter(function(item) { return recent.indexOf(item.id) === -1; });
      return (candidates.length ? candidates : list)[Math.floor(Math.random() * (candidates.length ? candidates.length : list.length))];
    }
    function renderThemes() { $('#answerBookThemes').html(themes.map(function(theme) { return '<button type="button" class="answer-book-theme' + (theme.id === state.theme ? ' is-active' : '') + '" data-theme="' + theme.id + '" aria-pressed="' + (theme.id === state.theme ? 'true' : 'false') + '">' + theme.name + '</button>'; }).join('')); }
    function applyTheme(id) { if (!answers[id]) return; state.theme = id; var theme = currentTheme(); $('#answerBookCoverTheme').text(theme.name); $('#answerBookCoverSub').text(theme.subtitle); $('#answerBookSource').text('—— ' + theme.name + '答案之书'); renderThemes(); }
    function setTheme(id) { if (isBusy() || !answers[id] || id === state.theme) return; if (state.phase === 'open') closeBook(function() { applyTheme(id); }); else applyTheme(id); }
    function applyMode(mode) { state.mode = mode; $('[data-mode]').removeClass('is-active').attr('aria-selected', 'false'); $('[data-mode="' + mode + '"]').addClass('is-active').attr('aria-selected', 'true'); }
    function setMode(mode) { if (isBusy() || mode === state.mode) return; if (state.phase === 'open') closeBook(function() { applyMode(mode); }); else applyMode(mode); }
    function saveHistory(answer, question, answeredAt) { var record = { id: randomId(), question: question, answerId: answer.id, answerText: answer.text, theme: answer.theme, mode: state.mode, createdAt: answeredAt.toISOString() }; state.history.unshift(record); state.history = state.history.slice(0, 50); write(keys.history, state.history); state.recent.unshift({ theme: answer.theme, answerId: answer.id }); state.recent = state.recent.slice(0, 15); write(keys.recent, state.recent); }
    function setControlsBusy(busy, label) { $('#answerBookOpen').prop('disabled', busy); $('[data-mode], [data-theme]').prop('disabled', busy); $book.attr('aria-busy', busy ? 'true' : 'false'); if (busy) $('#answerBookOpen').html('<i class="fas fa-spinner fa-spin"></i>' + label); else if (state.phase === 'open') $('#answerBookOpen').html('<i class="fas fa-book-reader"></i>再翻一页'); else $('#answerBookOpen').html('<i class="fas fa-book-open"></i>翻开答案之书'); }
    function waitForMotion(element, timeout, callback) {
      var token = ++state.motionToken;
      var finished = false;
      function finish(event) {
        if (event && (event.target !== element || event.propertyName !== 'transform')) return;
        if (finished || token !== state.motionToken) return;
        finished = true;
        element.removeEventListener('transitionend', finish);
        clearTimeout(finish.timer);
        callback();
      }
      element.addEventListener('transitionend', finish);
      finish.timer = setTimeout(finish, timeout);
    }
    function commitAnswer(answer, question, answeredAt) {
      state.answer = answer;
      state.question = question;
      state.answeredAt = answeredAt;
      state.phase = 'open';
      $book.removeClass('is-opening is-turning is-page-resetting').addClass('is-open').attr('aria-label', '再翻一页');
      $turningAnswer.empty();
      $turningSource.empty();
      $('#answerBookActions').addClass('is-visible');
      $('#answerBookHint').text('答案已经写在这一页');
      setResultStatus(state.mode === 'daily' ? '今日答案已揭晓' : '答案已揭晓');
      setControlsBusy(false);
      saveHistory(answer, question, answeredAt);
    }
    function openBook() {
      if (state.phase !== 'closed') return;
      var answer = getAnswer();
      if (!answer) return;
      var question = $('#answerBookQuestion').val().trim();
      var answeredAt = new Date();
      state.phase = 'opening';
      $answer.text(answer.text);
      $book.removeClass('is-open is-closing').addClass('is-opening').attr('aria-label', '正在翻页');
      $('#answerBookActions').removeClass('is-visible');
      $('#answerBookHint').text(state.mode === 'daily' ? '今日的答案已为你留在这一页' : '让书页慢慢展开');
      setResultStatus('正在翻页');
      setControlsBusy(true, '正在翻页');
      if (isReducedMotion()) { commitAnswer(answer, question, answeredAt); return; }
      waitForMotion($turningPage[0], 1650, function() { commitAnswer(answer, question, answeredAt); });
    }
    function turnPage() {
      if (state.phase !== 'open' || !state.answer) return;
      var answer = getAnswer();
      if (!answer) return;
      var question = $('#answerBookQuestion').val().trim();
      var answeredAt = new Date();
      var previousTheme = currentTheme(state.answer.theme);
      state.phase = 'turning';
      $('#answerBookActions').removeClass('is-visible');
      $('#answerBookHint').text('下一页正在回答你');
      setResultStatus('正在翻页');
      setControlsBusy(true, '正在翻页');
      if (isReducedMotion()) { $answer.text(answer.text); commitAnswer(answer, question, answeredAt); return; }
      $turningAnswer.text(state.answer.text);
      $turningSource.text('—— ' + previousTheme.name + '答案之书');
      $book.addClass('is-page-resetting');
      if ($book[0]) void $book[0].offsetWidth;
      $answer.text(answer.text);
      $book.addClass('is-turning').removeClass('is-page-resetting');
      waitForMotion($turningPage[0], 1150, function() { commitAnswer(answer, question, answeredAt); });
    }
    function closeBook(afterClose) {
      if (state.phase === 'closed') { if (afterClose) afterClose(); return; }
      if (state.phase !== 'open') return;
      state.phase = 'closing';
      $('#answerBookActions').removeClass('is-visible');
      $('#answerBookHint').text('把这一页轻轻收好');
      setResultStatus('正在合书');
      setControlsBusy(true, '正在合书');
      $book.removeClass('is-open').addClass('is-closing').attr('aria-label', '正在合上答案之书');
      function finishClose() {
        state.phase = 'closed';
        state.answer = null;
        state.question = '';
        state.answeredAt = null;
        $book.removeClass('is-closing').attr('aria-label', '翻开答案之书');
        $answer.empty();
        $turningAnswer.empty();
        $turningSource.empty();
        $('#answerBookHint').text('请在心中默念一个问题');
        setResultStatus('等待翻阅');
        setControlsBusy(false);
        if (afterClose) afterClose();
      }
      if (isReducedMotion()) { finishClose(); return; }
      waitForMotion($('.answer-book-cover')[0], 1700, finishClose);
    }
    function requestAnswer() { if (state.phase === 'closed') openBook(); else if (state.phase === 'open') turnPage(); }
    function copyAnswer() { if (!state.answer) return; var text = state.answer.text + '\n—— ' + currentTheme(state.answer.theme).name + '答案之书'; function done() { showNotice('答案已复制'); } if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(done).catch(function() { fallbackCopy(text); }); } else { fallbackCopy(text); } }
    function fallbackCopy(text) { var input = document.createElement('textarea'); input.value = text; document.body.appendChild(input); input.select(); try { document.execCommand('copy'); showNotice('答案已复制'); } catch (error) { showNotice('暂时无法复制，请手动选择文字。'); } document.body.removeChild(input); }
    function formatDate(value) { var date = new Date(value); return date.getFullYear() + '.' + String(date.getMonth() + 1).padStart(2, '0') + '.' + String(date.getDate()).padStart(2, '0') + ' ' + String(date.getHours()).padStart(2, '0') + ':' + String(date.getMinutes()).padStart(2, '0'); }
    function escapeHtml(text) { return $('<div>').text(text).html(); }
    function renderHistory() { var content = state.history.length ? state.history.map(function(item) { var theme = currentTheme(item.theme); return '<div class="answer-book-history-item"><p>' + escapeHtml(item.question || '藏在心里的问题') + '</p><p>“' + escapeHtml(item.answerText) + '”</p><small>' + theme.name + ' · ' + (item.mode === 'daily' ? '今日答案' : '随心一问') + ' · ' + formatDate(item.createdAt) + '</small><button type="button" class="answer-book-delete" data-history-id="' + item.id + '" aria-label="删除记录"><i class="fas fa-trash-alt"></i></button></div>'; }).join('') : '<p class="answer-book-empty">还没有翻阅记录。</p>'; $('#answerBookHistoryList').html(content); }
    function openLayer(id, trigger) { state.layerTrigger = trigger || document.activeElement; $('#' + id).addClass('is-visible').attr('aria-hidden', 'false'); $('body').addClass('answer-book-layer-open'); setTimeout(function() { $('#' + id).find('.answer-book-close').trigger('focus'); }, 0); }
    function closeLayer(id) { $('#' + id).removeClass('is-visible').attr('aria-hidden', 'true'); if (!$('.answer-book-drawer.is-visible').length) { $('body').removeClass('answer-book-layer-open'); if (state.layerTrigger && document.contains(state.layerTrigger)) state.layerTrigger.focus(); state.layerTrigger = null; } }
    function canvasFont(size, family, weight) { return (weight || 400) + ' ' + size + 'px ' + family; }
    function wrapCanvasText(ctx, text, maxWidth, maxLines) {
      var chars = Array.from(String(text || '').replace(/\s+/g, ' ').trim());
      var noLineStart = '，。！？；：、）》」』】…';
      var lines = [];
      var line = '';
      chars.forEach(function(character) {
        var candidate = line + character;
        if (!line || ctx.measureText(candidate).width <= maxWidth || noLineStart.indexOf(character) !== -1) line = candidate;
        else { lines.push(line); line = character; }
      });
      if (line) lines.push(line);
      if (!lines.length) return [''];
      if (lines.length <= maxLines) return lines;
      var visible = lines.slice(0, maxLines - 1);
      var last = lines.slice(maxLines - 1).join('');
      while (last.length > 1 && ctx.measureText(last + '…').width > maxWidth) last = last.slice(0, -1);
      visible.push(last.replace(/[，。；：、]+$/, '') + '…');
      return visible;
    }
    function getAnswerLayout(ctx, text, maxWidth) {
      var kai = '"Kaiti SC", STKaiti, KaiTi, serif';
      for (var size = 104; size >= 66; size -= 2) {
        ctx.font = canvasFont(size, kai, 500);
        if (ctx.measureText(text).width <= maxWidth) return { fontSize: size, lines: [text] };
      }
      ctx.font = canvasFont(92, kai, 500);
      return { fontSize: 92, lines: wrapCanvasText(ctx, text, maxWidth, 3) };
    }
    function drawPaperTexture(ctx, width, height) {
      ctx.fillStyle = '#faf4e6';
      ctx.fillRect(0, 0, width, height);
      for (var i = 0; i < 260; i++) {
        var x = 38 + ((i * 137) % (width - 76));
        var y = 34 + ((i * 83) % (height - 68));
        ctx.fillStyle = 'rgba(113, 91, 51,' + (0.018 + (i % 5) * 0.006) + ')';
        ctx.fillRect(x, y, 1 + (i % 2), 1 + ((i + 1) % 2));
      }
      ctx.strokeStyle = 'rgba(64, 84, 55, .62)';
      ctx.lineWidth = 2;
      ctx.strokeRect(44, 44, width - 88, height - 88);
      ctx.strokeStyle = 'rgba(190, 151, 71, .5)';
      ctx.lineWidth = 1;
      ctx.strokeRect(57, 57, width - 114, height - 114);
    }
    function drawPostmark(ctx) {
      ctx.save();
      ctx.translate(1375, 144);
      ctx.rotate(-0.12);
      ctx.strokeStyle = 'rgba(76, 103, 70, .46)';
      ctx.fillStyle = 'rgba(76, 103, 70, .62)';
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(0, 0, 70, 0, Math.PI * 2); ctx.stroke();
      ctx.beginPath(); ctx.arc(0, 0, 55, 0, Math.PI * 2); ctx.stroke();
      ctx.font = canvasFont(19, 'Arial, sans-serif', 700); ctx.textAlign = 'center'; ctx.fillText('MEOWV', 0, -5);
      ctx.font = canvasFont(15, 'Arial, sans-serif', 400); ctx.fillText('ANSWER BOOK', 0, 20);
      for (var i = 0; i < 4; i++) { ctx.beginPath(); ctx.moveTo(-155, -24 + i * 17); ctx.lineTo(-78, -24 + i * 17); ctx.stroke(); }
      ctx.restore();
    }
    function drawSprig(ctx) {
      ctx.save();
      ctx.strokeStyle = 'rgba(79, 112, 67, .5)';
      ctx.fillStyle = 'rgba(102, 132, 76, .18)';
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(92, 826); ctx.bezierCurveTo(145, 794, 178, 752, 210, 700); ctx.stroke();
      [[122, 800, -16], [146, 778, 18], [170, 748, -14], [192, 716, 14]].forEach(function(leaf) {
        ctx.save(); ctx.translate(leaf[0], leaf[1]); ctx.rotate(leaf[2] * Math.PI / 180); ctx.beginPath(); ctx.ellipse(0, 0, 20, 9, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke(); ctx.restore();
      });
      ctx.restore();
    }
    function drawShareCard(qrDrawable) {
      var canvas = document.getElementById('answerBookShareCanvas');
      var ctx = canvas.getContext('2d');
      var width = canvas.width;
      var height = canvas.height;
      var theme = currentTheme(state.answer.theme);
      var showQuestion = Boolean(state.question && state.shareQuestion);
      var kai = '"Kaiti SC", STKaiti, KaiTi, serif';
      var sans = '"PingFang SC", "Microsoft YaHei", Arial, sans-serif';
      ctx.clearRect(0, 0, width, height);
      drawPaperTexture(ctx, width, height);
      drawPostmark(ctx);
      drawSprig(ctx);
      ctx.fillStyle = '#324633';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.font = canvasFont(31, sans, 600);
      ctx.fillText('答案之书', 92, 124);
      ctx.fillStyle = '#9c8251';
      ctx.font = canvasFont(18, sans, 500);
      ctx.fillText('A NOTE FOR YOU', 94, 158);
      ctx.strokeStyle = 'rgba(154, 126, 72, .42)';
      ctx.beginPath(); ctx.moveTo(92, 180); ctx.lineTo(520, 180); ctx.stroke();
      if (showQuestion) {
        ctx.fillStyle = '#8b7449';
        ctx.font = canvasFont(22, sans, 600);
        ctx.fillText('你写下的问题', 116, 242);
        ctx.fillStyle = '#5d6456';
        ctx.font = canvasFont(42, kai, 400);
        var questionLines = wrapCanvasText(ctx, state.question, 1240, 3);
        questionLines.forEach(function(line, index) { ctx.fillText(line, 116, 300 + index * 56); });
      }
      var answerLayout = getAnswerLayout(ctx, state.answer.text, 1160);
      var answerLineHeight = answerLayout.fontSize * 1.32;
      var answerCenterY = showQuestion ? 572 : 470;
      var firstBaseline = answerCenterY - ((answerLayout.lines.length - 1) * answerLineHeight) / 2 + answerLayout.fontSize * .34;
      ctx.font = canvasFont(answerLayout.fontSize, kai, 500);
      ctx.fillStyle = '#263d2e';
      ctx.textAlign = 'center';
      var widths = answerLayout.lines.map(function(line) { return ctx.measureText(line).width; });
      answerLayout.lines.forEach(function(line, index) { ctx.fillText(line, width / 2, firstBaseline + index * answerLineHeight); });
      var quoteSize = answerLayout.fontSize + 34;
      ctx.font = canvasFont(quoteSize, kai, 500);
      ctx.fillStyle = '#bc9140';
      ctx.textAlign = 'left';
      var openQuoteWidth = ctx.measureText('『').width;
      var lastIndex = answerLayout.lines.length - 1;
      ctx.fillText('『', width / 2 - widths[0] / 2 - openQuoteWidth - 15, firstBaseline - answerLayout.fontSize * .32);
      ctx.fillText('』', width / 2 + widths[lastIndex] / 2 + 12, firstBaseline + lastIndex * answerLineHeight + answerLayout.fontSize * .28);
      ctx.fillStyle = '#697160';
      ctx.textAlign = 'left';
      ctx.font = canvasFont(23, sans, 500);
      ctx.fillText(theme.name + '答案之书 · ' + (state.mode === 'daily' ? '今日答案' : '随心一问'), 92, 904);
      ctx.fillStyle = '#9a8c71';
      ctx.font = canvasFont(19, sans, 400);
      ctx.fillText(formatDate(state.answeredAt), 92, 940);
      ctx.drawImage(qrDrawable, 1348, 748, 172, 172);
      $('#answerBookShareCanvas').attr('aria-label', '答案明信片，答案：' + state.answer.text + (showQuestion ? '，问题：' + state.question : ''));
    }
    function getShareQr() {
      var host = document.getElementById('answerBookQrSource');
      var existing = host.querySelector('canvas, img');
      if (existing) return Promise.resolve(existing);
      if (typeof QRCode === 'undefined') return Promise.reject(new Error('二维码组件加载失败'));
      try {
        new QRCode(host, { text: shareUrl, width: 172, height: 172, colorDark: '#263d2e', colorLight: 'rgba(0,0,0,0)', correctLevel: QRCode.CorrectLevel ? QRCode.CorrectLevel.H : 2 });
      } catch (error) { return Promise.reject(error); }
      return new Promise(function(resolve, reject) {
        setTimeout(function() {
          var drawable = host.querySelector('canvas, img');
          if (!drawable) { reject(new Error('二维码生成失败')); return; }
          if (drawable.tagName === 'IMG' && !drawable.complete) { drawable.onload = function() { resolve(drawable); }; drawable.onerror = function() { reject(new Error('二维码生成失败')); }; }
          else resolve(drawable);
        }, 30);
      });
    }
    function releaseShareDownload() { if (state.shareDownloadObjectUrl && state.shareDownloadUrl) URL.revokeObjectURL(state.shareDownloadUrl); state.shareDownloadUrl = ''; state.shareDownloadObjectUrl = false; $('#answerBookDownload').attr('aria-disabled', 'true').removeAttr('href download'); }
    function createShareDownload() {
      var canvas = document.getElementById('answerBookShareCanvas');
      if (!canvas.toBlob) return Promise.resolve({ url: canvas.toDataURL('image/png'), objectUrl: false });
      return new Promise(function(resolve, reject) { canvas.toBlob(function(blob) { if (blob) resolve({ url: URL.createObjectURL(blob), objectUrl: true }); else reject(new Error('PNG 编码失败，请重试。')); }, 'image/png'); });
    }
    function renderShareCard() {
      var token = ++state.shareRenderToken;
      state.shareReady = false;
      releaseShareDownload();
      $('#answerBookShareNotice').text('正在制作你的答案明信片…');
      var fontsReady = document.fonts && document.fonts.ready ? document.fonts.ready.catch(function() {}) : Promise.resolve();
      return Promise.all([fontsReady, getShareQr()]).then(function(values) {
        if (token !== state.shareRenderToken || !state.answer) return;
        drawShareCard(values[1]);
        return createShareDownload();
      }).then(function(download) {
        if (!download) return;
        if (token !== state.shareRenderToken || !state.answer) { if (download.objectUrl) URL.revokeObjectURL(download.url); return; }
        state.shareDownloadUrl = download.url;
        state.shareDownloadObjectUrl = download.objectUrl;
        state.shareReady = true;
        $('#answerBookDownload').attr({ 'aria-disabled': 'false', href: download.url, download: '答案之书-' + todayKey().replace(/-/g, '') + '.png' });
        $('#answerBookShareNotice').text('图片已就绪，问题和答案只在你的浏览器中生成。');
      }).catch(function(error) {
        if (token !== state.shareRenderToken) return;
        $('#answerBookShareNotice').text((error && error.message) || '分享卡片生成失败，请刷新后重试。');
      });
    }
    function openShareCard(trigger) {
      if (state.phase !== 'open' || !state.answer) return;
      state.shareQuestion = Boolean(state.question);
      $('#answerBookShareQuestionOption').prop('hidden', !state.question);
      $('#answerBookShareQuestionToggle').attr('aria-checked', state.shareQuestion ? 'true' : 'false');
      openLayer('answerBookShareDrawer', trigger);
      renderShareCard();
    }
    $(document).ready(function() {
      state.history = read(keys.history, []); state.recent = read(keys.recent, []); renderThemes();
      $('#answerBookThemes').on('click', '[data-theme]', function() { setTheme($(this).data('theme')); });
      $('[data-mode]').on('click', function() { setMode($(this).data('mode')); });
      $('#answerBookOpen').on('click', requestAnswer);
      $book.on('click', requestAnswer).on('keydown', function(event) { if (!event.repeat && (event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); requestAnswer(); } });
      $('#answerBookAgain').on('click', turnPage); $('#answerBookClose').on('click', function() { closeBook(); }); $('#answerBookCopy').on('click', copyAnswer); $('#answerBookShare').on('click', function() { openShareCard(this); });
      $('#answerBookShareQuestionToggle').on('click', function() { state.shareQuestion = $(this).attr('aria-checked') !== 'true'; $(this).attr('aria-checked', state.shareQuestion ? 'true' : 'false'); renderShareCard(); });
      $(window).on('beforeunload', releaseShareDownload);
      $('#answerBookHistory').on('click', function() { renderHistory(); openLayer('answerBookHistoryDrawer', this); });
      $('.answer-book-close').on('click', function() { closeLayer($(this).data('close')); });
      $('.answer-book-drawer').on('click', function(event) { if (event.target === this) closeLayer(this.id); });
      $(document).on('keydown', function(event) { if (event.key === 'Escape') { var $visible = $('.answer-book-drawer.is-visible').last(); if ($visible.length) closeLayer($visible.attr('id')); } });
      $('#answerBookHistoryList').on('click', '[data-history-id]', function() { state.history = state.history.filter(function(item) { return item.id !== $(this).data('history-id'); }); write(keys.history, state.history); renderHistory(); });
      $('#answerBookClearHistory').on('click', function() { if (state.history.length && window.confirm('确定清空全部本地历史记录吗？此操作无法恢复。')) { state.history = []; state.recent = []; write(keys.history, state.history); write(keys.recent, state.recent); renderHistory(); showNotice('本地历史已清空'); } });
    });
  })();
</script>
