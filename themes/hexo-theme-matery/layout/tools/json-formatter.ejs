<%
    var toolTitle = 'JSON 格式化';
    var toolDesc = '';
    if (site.data && site.data.tools) {
        var tool = site.data.tools.find(function(t) { return t.slug === page.toolSlug; });
        if (tool) {
            toolTitle = tool.emoji + ' ' + tool.name;
            toolDesc = tool.description;
        }
    }
%>
<%- partial('_partial/bg-cover') %>

<style>
  .tool-container { margin-top: -50px; margin-bottom: 30px; }
  .tool-container .card { border-radius: 8px; }
  .tool-container .card .card-content .card-title { font-size: 1.4rem; font-weight: 600; margin-bottom: 20px; }

  .toolbar {
    display: flex; gap: 10px; margin-bottom: 24px; flex-wrap: wrap; justify-content: flex-end;
  }
  .toolbar .btn {
    border-radius: 20px; padding: 0 20px; height: 36px; line-height: 36px;
    font-size: 0.9rem; letter-spacing: 1px; display: inline-flex; align-items: center; gap: 6px;
  }
  .toolbar .btn i {
    font-size: 0.9rem;
  }
  .toolbar .btn.primary { background: linear-gradient(135deg, #5a9600 0%, #7ccd00 100%); }
  .toolbar .btn.primary:hover { box-shadow: 0 4px 12px rgba(90,150,0,0.4); }
  .toolbar .btn.outline {
    background: transparent; color: #666; border: 1px solid #ddd; box-shadow: none;
  }
  .toolbar .btn.outline:hover { border-color: #5a9600; color: #5a9600; }

  .json-columns { display: flex; gap: 16px; }
  .json-col { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .json-col .col-header {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;
  }
  .json-col .col-label { font-size: 0.9rem; font-weight: 600; color: #666; }

  .editor-wrap {
    position: relative; flex: 1;
    border: 2px solid #e8e8e8; border-radius: 10px; overflow: hidden;
    background: #fafafa; min-height: 300px;
    transition: border-color 0.3s, background 0.3s;
  }
  .editor-wrap:focus-within { border-color: #5a9600; background: #fff; }

  .line-numbers {
    position: absolute; left: 0; top: 0; bottom: 0; width: 40px;
    padding: 14px 4px; text-align: right; color: #999;
    font-size: 0.9rem; font-family: 'SF Mono','Fira Code','Consolas',monospace;
    line-height: 1.6; background: #f0f0f0; user-select: none;
    overflow: hidden; white-space: pre; box-sizing: border-box; z-index: 1;
  }

  .editor-wrap textarea {
    width: 100%; border: none; border-radius: 0; resize: vertical;
    min-height: 300px;
    padding: 14px 16px 14px 56px;
    font-size: 0.9rem; font-family: 'SF Mono','Fira Code','Consolas',monospace;
    line-height: 1.6; background: transparent; box-sizing: border-box;
    outline: none;
  }
  .editor-wrap textarea.output-area { background: #f5f5f5; color: #333; }
  .editor-wrap textarea.output-area:focus { background: #f5f5f5; }

  .editor-wrap.error { border-color: #e53935; background: #fff5f5; }
  .editor-wrap.error .line-numbers { background: #fce4e4; }

  .copy-btn {
    position: absolute; top: 8px; right: 8px; z-index: 2;
    width: 28px; height: 28px; border-radius: 50%; border: 1px solid #ddd;
    background: rgba(255,255,255,0.9); cursor: pointer; font-size: 0.8rem; color: #aaa;
    display: inline-flex; align-items: center; justify-content: center;
    transition: all 0.2s; line-height: 1;
  }
  .copy-btn:hover { border-color: #5a9600; color: #5a9600; background: #f6fbf0; }
  .copy-btn.copied { border-color: #5a9600; background: #5a9600; color: #fff; }

  @media only screen and (max-width: 601px) {
    .tool-container { margin-top: -30px; }
    .json-columns { flex-direction: column; }
    .editor-wrap { min-height: 180px; }
    .editor-wrap textarea { min-height: 180px; }
  }
</style>

<main class="content">
  <div class="container tool-container">
    <div class="card">
      <div class="card-content">
        <span class="card-title" style="display: inline-block"><%= toolTitle %></span>
        <% if (toolDesc) { %>
        <span style="color: #999; font-size: 0.9rem; margin-left: 8px;"><%= toolDesc %></span>
        <% } %>

        <div class="toolbar">
          <button class="btn waves-effect primary" id="formatBtn"><i class="fas fa-align-left"></i> 格式化</button>
          <button class="btn waves-effect primary" id="compressBtn"><i class="fas fa-compress"></i> 压缩</button>
          <button class="btn waves-effect outline" id="validateBtn"><i class="fas fa-check-circle"></i> 校验</button>
        </div>

          <div class="json-columns">
            <div class="json-col">
              <div class="col-header">
                <span class="col-label">输入</span>
              </div>
              <div class="editor-wrap">
                <div class="line-numbers" id="inputLineNumbers">1</div>
                <textarea id="inputText" placeholder='{"key":"value"}'></textarea>
                <button class="copy-btn" id="clearBtn" title="清空"><i class="fas fa-times"></i></button>
              </div>
            </div>
            <div class="json-col">
              <div class="col-header">
                <span class="col-label">输出</span>
              </div>
              <div class="editor-wrap">
                <div class="line-numbers" id="outputLineNumbers">1</div>
                <textarea id="outputText" class="output-area" placeholder="结果将显示在这里..." readonly></textarea>
                <button class="copy-btn" id="copyBtn" title="复制"><i class="fas fa-copy"></i></button>
              </div>
            </div>
          </div>
      </div>
    </div>

    <div class="card">
      <% if (theme.valine && theme.valine.enable) { %>
      <%- partial('_partial/valine') %>
      <% } %>
    </div>
  </div>
</main>

<script>
  function updateLineNumbers($textarea, $numbers) {
    var lines = $textarea.val().split('\n').length;
    var nums = [];
    for (var i = 1; i <= lines; i++) nums.push(i);
    $numbers.text(nums.join('\n'));
  }

  function getOutputWrap() {
    return $('#outputText').closest('.editor-wrap');
  }

  function formatJSON() {
    var input = $('#inputText').val().trim();
    if (!input) return;
    try {
      var obj = JSON.parse(input);
      $('#outputText').val(JSON.stringify(obj, null, 2));
      getOutputWrap().removeClass('error');
    } catch (e) {
      $('#outputText').val('JSON 解析错误:\n' + e.message);
      getOutputWrap().addClass('error');
    }
    updateLineNumbers($('#outputText'), $('#outputLineNumbers'));
  }

  function compressJSON() {
    var input = $('#inputText').val().trim();
    if (!input) return;
    try {
      var obj = JSON.parse(input);
      $('#outputText').val(JSON.stringify(obj));
      getOutputWrap().removeClass('error');
    } catch (e) {
      $('#outputText').val('JSON 解析错误:\n' + e.message);
      getOutputWrap().addClass('error');
    }
    updateLineNumbers($('#outputText'), $('#outputLineNumbers'));
  }

  function validateJSON() {
    var input = $('#inputText').val().trim();
    if (!input) { M.toast({html: '请输入 JSON 内容', classes: 'rounded'}); return; }
    try {
      JSON.parse(input);
      getOutputWrap().removeClass('error');
      M.toast({html: 'JSON 格式正确', classes: 'rounded green'});
    } catch (e) {
      $('#outputText').val('JSON 校验失败:\n' + e.message);
      getOutputWrap().addClass('error');
      M.toast({html: 'JSON 格式错误: ' + e.message, classes: 'rounded red'});
    }
    updateLineNumbers($('#outputText'), $('#outputLineNumbers'));
  }

  $(document).ready(function() {
    updateLineNumbers($('#inputText'), $('#inputLineNumbers'));

    $('#formatBtn').on('click', formatJSON);
    $('#compressBtn').on('click', compressJSON);
    $('#validateBtn').on('click', validateJSON);

    $('#inputText').on('input', function() {
      updateLineNumbers($(this), $('#inputLineNumbers'));
    });

    $('#inputText').on('scroll', function() {
      $('#inputLineNumbers').scrollTop(this.scrollTop);
    });

    $('#outputText').on('scroll', function() {
      $('#outputLineNumbers').scrollTop(this.scrollTop);
    });

    $('#copyBtn').on('click', function() {
      var text = $('#outputText').val();
      if (!text) return;
      navigator.clipboard.writeText(text).then(function() {
        var $btn = $('#copyBtn');
        $btn.addClass('copied').html('<i class="fas fa-check"></i>');
        setTimeout(function() { $btn.removeClass('copied').html('<i class="fas fa-copy"></i>'); }, 1500);
      });
    });

    $('#clearBtn').on('click', function() {
      $('#inputText').val('');
      $('#outputText').val('');
      getOutputWrap().removeClass('error');
      updateLineNumbers($('#inputText'), $('#inputLineNumbers'));
      updateLineNumbers($('#outputText'), $('#outputLineNumbers'));
    });
  });
</script>
