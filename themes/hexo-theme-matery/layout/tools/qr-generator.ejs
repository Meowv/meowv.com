<%
    var toolTitle = '二维码生成';
    var toolDesc = '';
    if (site.data && site.data.tools) {
        var tool = site.data.tools.find(function(t) { return t.slug === page.toolSlug; });
        if (tool) {
            toolTitle = tool.emoji + ' ' + tool.name;
            toolDesc = tool.description;
        }
    }
%>
<%- partial('_partial/bg-cover') %>

<style>
  .tool-container { margin-top: -50px; margin-bottom: 30px; }
  .tool-container .card { border-radius: 8px; }
  .tool-container .card .card-content .card-title { font-size: 1.4rem; font-weight: 600; margin-bottom: 20px; }

  .qr-layout { display: flex; gap: 30px; align-items: flex-start; }
  .qr-left { flex: 1; min-width: 0; }
  .qr-right { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; }

  .qr-left .input-field { margin-top: 0; }
  .qr-left textarea {
    width: 100%; min-height: 80px; border: 2px solid #e8e8e8; border-radius: 10px;
    padding: 12px 16px; font-size: 0.95rem; line-height: 1.6; resize: vertical;
    background: #fafafa; box-sizing: border-box; outline: none; transition: border-color 0.3s;
  }
  .qr-left textarea:focus { border-color: #26a69a; background: #fff; }

  .options-row { display: flex; gap: 20px; margin: 16px 0; flex-wrap: wrap; align-items: center; }
  .options-row label { font-size: 0.85rem; color: #666; margin-right: 4px; }
  .options-row select {
    display: inline-block; width: auto; border: 1px solid #ddd; border-radius: 6px;
    padding: 4px 8px; font-size: 0.85rem; background: #fff;
  }

  #qrcode { margin: 0 auto; display: flex; justify-content: center; }
  #qrcode canvas { border-radius: 10px; }
  #downloadBtn {
    border-radius: 20px; padding: 0 24px; height: 36px; line-height: 36px;
    font-size: 0.85rem; margin-top: 16px;
    background: linear-gradient(135deg, #5a9600 0%, #7ccd00 100%);
  }
  #downloadBtn:hover { box-shadow: 0 4px 12px rgba(90,150,0,0.4); }
  #downloadBtn:disabled { background: #bdbdbd; box-shadow: none; }
  .qr-placeholder {
    width: 200px; height: 200px; border: 2px dashed #ddd; border-radius: 10px;
    display: flex; align-items: center; justify-content: center; color: #ccc;
    font-size: 0.85rem;
  }

  @media only screen and (max-width: 601px) {
    .tool-container { margin-top: -30px; }
    .qr-layout { flex-direction: column; align-items: center; }
  }
</style>

<main class="content">
  <div class="container tool-container">
    <div class="card">
      <div class="card-content">
        <span class="card-title" style="display: inline-block"><%= toolTitle %></span>
        <% if (toolDesc) { %>
        <span style="color: #999; font-size: 0.9rem; margin-left: 8px;"><%= toolDesc %></span>
        <% } %>

        <div class="qr-layout">
          <div class="qr-left">
            <textarea id="qrInput" placeholder="请输入文本或链接..."></textarea>
            <div class="options-row">
              <div>
                <label>尺寸</label>
                <select id="sizeSelect">
                  <option value="200">小 (200)</option>
                  <option value="300" selected>中 (300)</option>
                  <option value="400">大 (400)</option>
                </select>
              </div>
              <div>
                <label>容错级别</label>
                <select id="levelSelect">
                  <option value="L">L (7%)</option>
                  <option value="M" selected>M (15%)</option>
                  <option value="Q">Q (25%)</option>
                  <option value="H">H (30%)</option>
                </select>
              </div>
            </div>
          </div>
          <div class="qr-right">
            <div id="qrcode"><div class="qr-placeholder">输入内容生成二维码</div></div>
            <button id="downloadBtn" class="btn waves-effect" disabled>下载 PNG</button>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <% if (theme.valine && theme.valine.enable) { %>
      <%- partial('_partial/valine') %>
      <% } %>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
  var levelMap = { L: 1, M: 0, Q: 3, H: 2 };

  function generateQR() {
    var text = $('#qrInput').val().trim();
    var size = parseInt($('#sizeSelect').val());
    var level = levelMap[$('#levelSelect').val()];

    if (!text) {
      $('#qrcode').html('<div class="qr-placeholder">输入内容生成二维码</div>');
      $('#downloadBtn').prop('disabled', true);
      return;
    }

    $('#qrcode').empty();

    new QRCode(document.getElementById('qrcode'), {
      text: text,
      width: size,
      height: size,
      correctLevel: level
    });

    $('#downloadBtn').prop('disabled', false);
  }

  function downloadQR() {
    var canvas = document.querySelector('#qrcode canvas');
    if (!canvas) return;
    var link = document.createElement('a');
    link.download = 'qrcode.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  }

  $(document).ready(function() {
    var qrTimeout;
    $('#qrInput').on('input', function() {
      clearTimeout(qrTimeout);
      qrTimeout = setTimeout(generateQR, 300);
    });
    $('#sizeSelect, #levelSelect').on('change', generateQR);
    $('#downloadBtn').on('click', downloadQR);
  });
</script>
