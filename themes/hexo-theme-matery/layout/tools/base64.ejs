<%
    var toolTitle = 'Base64 编解码';
    var toolDesc = '';
    if (site.data && site.data.tools) {
        var tool = site.data.tools.find(function(t) { return t.slug === page.toolSlug; });
        if (tool) {
            toolTitle = tool.emoji + ' ' + tool.name;
            toolDesc = tool.description;
        }
    }
%>
<%- partial('_partial/bg-cover') %>

<style>
  .tool-container { margin-top: -50px; margin-bottom: 30px; }
  .tool-container .card { border-radius: 8px; }

  .tabs-row { display: flex; gap: 0; margin-bottom: 16px; border-bottom: 2px solid #eee; }
  .tabs-row .tab-btn {
    padding: 10px 24px; border: none; background: none; cursor: pointer;
    font-size: 0.9rem; color: #999; transition: all 0.2s; border-bottom: 2px solid transparent;
    margin-bottom: -2px; outline: none;
  }
  .tabs-row .tab-btn.active { color: #5a9600; border-bottom-color: #5a9600; font-weight: 600; }
  .tabs-row .tab-btn:hover { color: #5a9600; }

  .tab-content { display: none; }
  .tab-content.active { display: block; }

  .tab-header {
    text-align: center; margin-bottom: 16px; display: flex; align-items: center;
    justify-content: center; gap: 12px;
  }
  .tab-header .mode-label {
    font-size: 0.85rem; font-weight: 600; color: #5a9600;
    background: #f2f8e8; padding: 4px 16px; border-radius: 12px;
    min-width: 100px; transition: all 0.3s;
  }
  .tab-header .mode-arrow { color: #ccc; font-size: 1rem; }

  .base64-columns { display: flex; gap: 0; align-items: stretch; }
  .base64-col { flex: 1; min-width: 0; display: flex; flex-direction: column; }

  .box-wrap { position: relative; flex: 1; display: flex; }

  .base64-col textarea {
    width: 100%; min-height: 220px; border: 2px solid #e8e8e8; border-radius: 10px;
    padding: 14px 16px; font-size: 0.9rem; font-family: 'SF Mono','Fira Code','Consolas',monospace;
    line-height: 1.6; resize: vertical; background: #fafafa; box-sizing: border-box;
    outline: none; transition: border-color 0.3s; flex: 1;
  }
  .base64-col textarea:focus { border-color: #5a9600; background: #fff; }

  .box-area {
    min-height: 220px; border: 2px dashed #ddd; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s; box-sizing: border-box; flex: 1;
  }

  .upload-area { cursor: pointer; background: #fafafa; }
  .upload-area:hover { border-color: #5a9600; background: #f6fbf0; }
  .upload-area .upload-label {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    cursor: pointer; color: #bbb; padding: 24px; width: 100%; text-align: center;
  }
  .upload-area .upload-label i { font-size: 3rem; display: block; }
  .upload-area .upload-label span { font-size: 0.85rem; color: #aaa; }
  .upload-area input[type=file] { display: none; }
  .upload-area.has-image { border: none; min-height: auto; background: none; cursor: default; }
  .upload-area.has-image .upload-label { display: none; }
  .upload-area .preview-img {
    max-width: 100%; max-height: 220px; border-radius: 8px; display: block; margin: 0 auto;
  }

  .preview-area { background: #fafafa; }
  .preview-area .preview-placeholder {
    color: #ccc; font-size: 0.85rem; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .preview-area .preview-placeholder i { font-size: 3rem; display: block; }
  .preview-area .preview-img {
    max-width: 100%; max-height: 220px; border-radius: 8px; display: block;
  }

  .swap-btn-wrap {
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; padding: 0 12px;
  }
  .swap-btn-wrap .btn-floating {
    width: 40px; height: 40px; background: linear-gradient(135deg, #5a9600, #7ccd00);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .swap-btn-wrap .btn-floating i { font-size: 1.1rem; line-height: 40px; }
  .swap-btn-wrap .btn-floating:hover { box-shadow: 0 4px 12px rgba(90,150,0,0.4); }

  .copy-btn {
    position: absolute; top: 8px; right: 8px; z-index: 2;
    width: 28px; height: 28px; border-radius: 50%; border: 1px solid #ddd;
    background: rgba(255,255,255,0.9); cursor: pointer; font-size: 0.8rem; color: #aaa;
    display: inline-flex; align-items: center; justify-content: center;
    transition: all 0.2s; line-height: 1;
  }
  .copy-btn:hover { border-color: #5a9600; color: #5a9600; background: #f6fbf0; }
  .copy-btn.copied { border-color: #5a9600; background: #5a9600; color: #fff; }

  @media only screen and (max-width: 601px) {
    .tool-container { margin-top: -30px; }
    .base64-columns { flex-direction: column; }
    .base64-col textarea { min-height: 140px; }
    .box-area { min-height: 140px; }
    .swap-btn-wrap { padding: 8px 0; }
    .swap-btn-wrap .btn-floating { transform: rotate(90deg); }
  }
</style>

<main class="content">
  <div class="container tool-container">
    <div class="card">
      <%- partial('_partial/tool-header', { toolTitle: toolTitle, toolDesc: toolDesc }) %>
      <div class="card-content">
        <div class="tabs-row">
          <button class="tab-btn active" data-tab="text">文本编解码</button>
          <button class="tab-btn" data-tab="image">图片编解码</button>
        </div>

        <!-- 文本编解码 -->
        <div class="tab-content active" id="tab-text">
          <div class="tab-header">
            <span class="mode-label" id="textModeLeft">原文</span>
            <span class="mode-arrow"><i class="fas fa-long-arrow-alt-right"></i></span>
            <span class="mode-label" id="textModeRight">Base64</span>
          </div>
          <div class="base64-columns">
            <div class="base64-col">
              <div class="box-wrap">
                <textarea id="textLeft" placeholder="在此输入..."></textarea>
              </div>
            </div>
            <div class="swap-btn-wrap">
              <button id="swapTextMode" class="btn-floating waves-effect waves-light">
                <i class="fas fa-exchange-alt"></i>
              </button>
            </div>
            <div class="base64-col">
              <div class="box-wrap">
                <textarea id="textRight" placeholder="编码结果..." readonly></textarea>
                <button class="copy-btn" id="copyTextRight" title="复制"><i class="fas fa-copy"></i></button>
              </div>
            </div>
          </div>
        </div>

        <!-- 图片编解码 -->
        <div class="tab-content" id="tab-image">
          <div class="tab-header">
            <span class="mode-label" id="imgModeLeft">图片</span>
            <span class="mode-arrow"><i class="fas fa-long-arrow-alt-right"></i></span>
            <span class="mode-label" id="imgModeRight">Base64</span>
          </div>
          <div class="base64-columns">
            <div class="base64-col">
              <div id="leftEncodeSection">
                <div class="box-area upload-area" id="uploadArea">
                  <label for="imageFile" class="upload-label">
                    <i class="fas fa-image"></i>
                    <span>点击选择图片</span>
                  </label>
                  <input type="file" id="imageFile" accept="image/*">
                  <img id="imagePreview" class="preview-img" alt="" hidden>
                </div>
              </div>
              <div id="leftDecodeSection" style="display:none;">
                <div class="box-wrap">
                  <textarea id="base64Input" placeholder="粘贴 Base64 编码字符串..."></textarea>
                </div>
              </div>
            </div>
            <div class="swap-btn-wrap">
              <button id="swapImageMode" class="btn-floating waves-effect waves-light">
                <i class="fas fa-exchange-alt"></i>
              </button>
            </div>
            <div class="base64-col">
              <div id="rightEncodeSection">
                <div class="box-wrap">
                  <textarea id="base64Output" placeholder="选择图片后自动生成 Base64..." readonly></textarea>
                  <button class="copy-btn" id="copyImageOutput" title="复制"><i class="fas fa-copy"></i></button>
                </div>
              </div>
              <div id="rightDecodeSection" style="display:none;">
                <div class="box-wrap">
                  <div class="box-area preview-area">
                    <span class="preview-placeholder" id="previewPlaceholder">
                      <i class="fas fa-image"></i>
                      <span>图片预览</span>
                    </span>
                    <img id="base64Preview" class="preview-img" alt="" hidden>
                  </div>
                  <button class="copy-btn" id="copyImagePreview" title="复制图片"><i class="fas fa-copy"></i></button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <% if (theme.valine && theme.valine.enable) { %>
      <%- partial('_partial/valine') %>
      <% } %>
    </div>
  </div>
</main>

<script>
  // 标签切换
  $('.tab-btn').on('click', function() {
    var tab = $(this).data('tab');
    $('.tab-btn').removeClass('active');
    $(this).addClass('active');
    $('.tab-content').removeClass('active');
    $('#tab-' + tab).addClass('active');
  });

  // ===== 文本编解码 =====
  var textEncodeMode = true;

  function textEncode(s) {
    try { return btoa(unescape(encodeURIComponent(s))); } catch(e) { return ''; }
  }
  function textDecode(s) {
    try { return decodeURIComponent(escape(atob(s))); } catch(e) { return ''; }
  }

  $('#textLeft').on('input', function() {
    var val = $(this).val();
    if (!val) { $('#textRight').val(''); return; }
    var result = textEncodeMode ? textEncode(val) : textDecode(val);
    $('#textRight').val(result || '');
  });

  $('#swapTextMode').on('click', function() {
    textEncodeMode = !textEncodeMode;
    if (textEncodeMode) {
      $('#textModeLeft').text('原文');
      $('#textModeRight').text('Base64');
    } else {
      $('#textModeLeft').text('Base64');
      $('#textModeRight').text('原文');
    }
    var lv = $('#textLeft').val();
    if (lv) {
      var result = textEncodeMode ? textEncode(lv) : textDecode(lv);
      $('#textRight').val(result || '');
    }
  });

  // 复制文本
  function copyText(btnId, sourceId) {
    $('#' + btnId).on('click', function() {
      var val = $('#' + sourceId).val();
      if (!val) return;
      navigator.clipboard.writeText(val).then(function() {
        var $b = $(this);
        $b.addClass('copied').html('<i class="fas fa-check"></i>');
        setTimeout(function() { $b.removeClass('copied').html('<i class="fas fa-copy"></i>'); }, 1500);
      }.bind(this));
    });
  }
  copyText('copyTextRight', 'textRight');

  // ===== 图片编解码 =====
  var imgEncodeMode = true;

  // 上传 → Base64
  $('#imageFile').on('change', function() {
    var file = this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(e) {
      var dataUrl = e.target.result;
      $('#base64Output').val(dataUrl);
      $('#imagePreview').attr('src', dataUrl).removeAttr('hidden');
      $('#uploadArea').addClass('has-image');
    };
    reader.readAsDataURL(file);
  });

  // Base64 → 实时预览
  $('#base64Input').on('input', function() {
    var base64 = $(this).val().trim();
    if (!base64) {
      $('#base64Preview').attr('hidden', true);
      $('#previewPlaceholder').show();
      return;
    }
    var src = base64;
    if (!base64.startsWith('data:')) src = 'data:image/png;base64,' + base64;
    $('#base64Preview').attr('src', src).removeAttr('hidden');
    $('#previewPlaceholder').hide();
  });

  // 复制（智能切换）
  $('#copyImageOutput').on('click', function() {
    if (imgEncodeMode) {
      var val = $('#base64Output').val();
      if (!val) return;
      navigator.clipboard.writeText(val).then(function() {
        var $b = $('#copyImageOutput');
        $b.addClass('copied').html('<i class="fas fa-check"></i>');
        setTimeout(function() { $b.removeClass('copied').html('<i class="fas fa-copy"></i>'); }, 1500);
      });
    }
  });

  $('#copyImagePreview').on('click', function() {
    var img = document.getElementById('base64Preview');
    if (!img || !img.src || img.hidden) return;
    var canvas = document.createElement('canvas');
    canvas.width = img.naturalWidth;
    canvas.height = img.naturalHeight;
    var ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0);
    canvas.toBlob(function(blob) {
      navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]).then(function() {
        var $b = $('#copyImagePreview');
        $b.addClass('copied').html('<i class="fas fa-check"></i>');
        setTimeout(function() { $b.removeClass('copied').html('<i class="fas fa-copy"></i>'); }, 1500);
      });
    });
  });

  // 互换
  $('#swapImageMode').on('click', function() {
    imgEncodeMode = !imgEncodeMode;
    if (imgEncodeMode) {
      $('#imgModeLeft').text('图片');
      $('#imgModeRight').text('Base64');
      $('#leftEncodeSection').show();
      $('#rightEncodeSection').show();
      $('#leftDecodeSection').hide();
      $('#rightDecodeSection').hide();
    } else {
      $('#imgModeLeft').text('Base64');
      $('#imgModeRight').text('图片');
      $('#leftDecodeSection').show();
      $('#rightDecodeSection').show();
      $('#leftEncodeSection').hide();
      $('#rightEncodeSection').hide();
    }
  });
</script>
