<%
var gradients = [
  'linear-gradient(135deg, #7c8cf8 0%, #a78bfa 100%)',
  'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
  'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
  'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
  'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
  'linear-gradient(135deg, #ff6a88 0%, #ff99ac 100%)',
  'linear-gradient(135deg, #ff9a44 0%, #fc6076 100%)',
  'linear-gradient(135deg, #36d1dc 0%, #5b86e5 100%)',
  'linear-gradient(135deg, #11998e 0%, #38ef7d 100%)',
  'linear-gradient(135deg, #fc5c7d 0%, #6a82fb 100%)',
  'linear-gradient(135deg, #f7971e 0%, #ffd200 100%)',
  'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
  'linear-gradient(135deg, #4568dc 0%, #b06ab3 100%)',
  'linear-gradient(135deg, #00c6fb 0%, #005bea 100%)',
  'linear-gradient(135deg, #ff5f6d 0%, #ffc371 100%)',
  'linear-gradient(135deg, #00b4db 0%, #0083b0 100%)',
  'linear-gradient(135deg, #a770ef 0%, #fdb99b 100%)',
  'linear-gradient(135deg, #2193b0 0%, #6dd5ed 100%)',
  'linear-gradient(135deg, #ee9ca7 0%, #ffdde1 100%)',
  'linear-gradient(135deg, #ffb75e 0%, #ed8f03 100%)',
  'linear-gradient(135deg, #f12711 0%, #f5af19 100%)',
  'linear-gradient(135deg, #12c2e9 0%, #c471ed 100%)',
  'linear-gradient(135deg, #f64f59 0%, #c471ed 100%)',
  'linear-gradient(135deg, #ff4b2b 0%, #ff416c 100%)',
  'linear-gradient(135deg, #1a2980 0%, #26d0ce 100%)',
  'linear-gradient(135deg, #e65c00 0%, #f9d423 100%)',
  'linear-gradient(135deg, #c471ed 0%, #12c2e9 100%)',
  'linear-gradient(135deg, #f857a6 0%, #ff5858 100%)',
  'linear-gradient(135deg, #e96443 0%, #904e95 100%)',
  'linear-gradient(135deg, #0ba360 0%, #3cba92 100%)',
];
%>
<%- partial('_partial/bg-cover') %>

<style>
    .labs-container {
        margin-top: -50px;
        margin-bottom: 30px;
    }
    .labs-container .tag-title {
        margin-bottom: 10px;
        color: #3C4858;
        font-size: 1.75rem;
        font-weight: 400;
    }
    .labs-section {
        margin-bottom: 20px;
    }
    .lab-row {
        margin-bottom: 0;
    }
    .lab-col {
        padding: 0.5rem;
        margin-bottom: 1.5rem;
    }
    .lab-col .lab-link {
        display: block;
        width: 100%;
        text-decoration: none;
        color: inherit;
    }
    .lab-col .lab-link:hover {
        text-decoration: none;
    }
    .lab-card {
        padding: 16px;
        border-radius: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
        position: relative;
        height: 110px;
        color: #fff !important;
        margin: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
    }
    .lab-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.25) !important;
    }
    .lab-card .lab-emoji {
        font-size: 1.6rem;
        margin-bottom: 4px;
        display: block;
        line-height: 1.2;
    }
    .lab-card .lab-name {
        font-size: 0.95rem;
        font-weight: bold;
        margin-bottom: 2px;
    }
    .lab-card .lab-desc {
        color: rgba(255,255,255,0.85);
        font-size: 0.7rem;
        line-height: 1.3;
    }
    .lab-card .lab-badges {
        position: absolute;
        top: 6px;
        right: 6px;
        display: flex;
        gap: 4px;
    }
    .lab-card .lab-badge {
        font-size: 0.6rem;
        padding: 2px 6px;
        border-radius: 8px;
        background: rgba(255,255,255,0.3);
        color: #fff;
        backdrop-filter: blur(4px);
        line-height: 1.4;
    }

    @media only screen and (max-width: 601px) {
        .lab-card {
            height: 100px;
            padding: 10px 12px;
        }
        .lab-card .lab-emoji {
            font-size: 1.4rem;
        }
        .lab-card .lab-name {
            font-size: 0.85rem;
        }
        .lab-card .lab-desc {
            font-size: 0.65rem;
        }
    }
</style>

<main class="content">
    <div class="container labs-container">
        <!-- 工具模块 -->
        <div class="card labs-section">
            <div class="card-content">
                <div class="tag-title">
                    <i class="fas fa-toolbox"></i>&nbsp;&nbsp;<%= __('tools') %>
                </div>
                <article>
                    <% if (site.data && site.data.tools) { %>
                    <% var tools = site.data.tools; %>
                    <div class="row lab-row">
                        <% for (var i = 0, len = tools.length; i < len; i++) { %>
                        <% var tool = tools[i]; %>
                        <div class="col s6 m6 l3 lab-col" data-aos="zoom-in-up">
                            <a href="<%= tool.url %>" class="lab-link">
                                <div class="card lab-card" style="background-image: <%= tool.gradient || gradients[i % gradients.length] %>">
                                    <span class="lab-emoji"><%= tool.emoji %></span>
                                    <div class="lab-name"><%= tool.name %></div>
                                    <div class="lab-desc"><%= tool.description %></div>
                                </div>
                            </a>
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                </article>
            </div>
        </div>

        <!-- 游戏模块 -->
        <div class="card labs-section">
            <div class="card-content">
                <div class="tag-title">
                    <i class="fas fa-gamepad"></i>&nbsp;&nbsp;<%= __('games') %>
                </div>
                <article>
                    <% if (site.data && site.data.games) { %>
                    <% var games = site.data.games; %>
                    <% var gameOffset = (typeof tools !== 'undefined') ? tools.length : 0; %>
                    <div class="row lab-row">
                        <% for (var i = 0, len = games.length; i < len; i++) { %>
                        <% var game = games[i]; %>
                        <div class="col s6 m6 l3 lab-col" data-aos="zoom-in-up">
                            <% if (game.fullscreen) { %>
                            <a href="/games/<%= game.slug %>/<%= game.entryFile || 'index.html' %>" target="_blank" class="lab-link">
                                <div class="card lab-card" style="background-image: <%= game.gradient || gradients[(gameOffset + i) % gradients.length] %>">
                                    <span class="lab-emoji"><%= game.emoji %></span>
                                    <div class="lab-name"><%= game.name %></div>
                                    <div class="lab-desc"><%= game.description %></div>
                                    <div class="lab-badges">
                                        <% if (game.mobile) { %><span class="lab-badge">📱</span><% } %>
                                        <span class="lab-badge">↗</span>
                                    </div>
                                </div>
                            </a>
                            <% } else { %>
                            <a href="/game/<%= game.slug %>/" class="lab-link">
                                <div class="card lab-card" style="background-image: <%= game.gradient || gradients[(gameOffset + i) % gradients.length] %>">
                                    <span class="lab-emoji"><%= game.emoji %></span>
                                    <div class="lab-name"><%= game.name %></div>
                                    <div class="lab-desc"><%= game.description %></div>
                                    <div class="lab-badges">
                                        <% if (game.mobile) { %><span class="lab-badge">📱</span><% } %>
                                    </div>
                                </div>
                            </a>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                </article>
            </div>
        </div>

        <% if (page.content && page.content.length > 0) { %>
        <div class="card">
            <div class="card-content">
                <%- page.content %>
            </div>
        </div>
        <% } %>

        <div class="card">
            <% if (theme.valine && theme.valine.enable) { %>
            <%- partial('_partial/valine') %>
            <% } %>
        </div>
    </div>
</main>