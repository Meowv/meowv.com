{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ranuts/shared": ["./src/features/office/runtime/shared/index.ts"],
      "@ranuts/shared/*": ["./src/features/office/runtime/shared/*"],
      "@ranuts/converter": ["./src/features/office/runtime/converter/index.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite.config.ts",
    "vite/**/*.ts",
    "eslint.config.js",
    "builtinBooksDevPlugin.ts"
  ]
}
