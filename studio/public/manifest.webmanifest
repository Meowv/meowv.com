      "icons": [{ "src": "/icons/studio-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Markdown",
      "url": "/markdown",
      "icons": [{ "src": "/icons/studio-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Office",
